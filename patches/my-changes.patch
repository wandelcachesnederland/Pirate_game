+afterEach(() => vi.restoreAllMocks());
+
+// Build only the state used by each real engine rule; skip the canvas/RAF.
+const shell = (): any => Object.create(Engine.prototype);
+
+function practice(): any {
+  const e = shell();
+  e.tutorial = true;
+  e.tutorialChapter = 'helm';
+  e.screen = 'playing';
+  e.nextId = 0;
+  e.wave = 1;
+  e.eraId = 'golden';
+  e.regionId = 'caribbean';
+  e.playerDef = ERA_FLAGSHIPS.golden;
+  e.islands = [{ x: 600, y: 0, maxR: 90, settlement: { fortress: { hp: 100 } } }];
+  e.makeShip = vi.fn((kind: ShipKind, x: number, y: number, angle: number) => {
+    const def = kind === 'player' ? ERA_FLAGSHIPS.golden : SHIP_DEFS[kind];
+    return {
+      id: ++e.nextId, def, team: kind === 'player' ? 0 : 1,
+      x, y, angle, vx: 0, vy: 0, fwd: 0, turnInput: 0, angVel: 0,
+      hp: def.hp, ghostHp: def.hp, maxHp: def.hp, crew: def.crew, maxCrew: def.crew,
+      sail: 0, sailTarget: 0, cannons: def.cannons, reloadL: 0, reloadR: 0,
+      reloadTime: def.reload, damage: def.damage, range: def.range, ballSpeed: def.ballSpeed,
+      sinking: -1, captured: false, surrendered: false, dead: false,
+    };
+  });
+  e.player = e.makeShip('player', 0, 0, 0);
+  e.input = { enabled: true, clear: vi.fn() };
+  e.sfx = {
+    duck: vi.fn(), upgrade: vi.fn(), fanfare: vi.fn(), chest: vi.fn(),
+    coin: vi.fn(), repair: vi.fn(), grapeshot: vi.fn(), hit: vi.fn(),
+  };
+  e.cb = { onScreen: vi.fn(), onUpgrade: vi.fn(), onGameOver: vi.fn() };
+  e.pstats = {
+    cannons: 3, reloadMul: 1, damageMul: 1, maxHp: 100,
+    speedMul: 1, turnMul: 1, rangeMul: 1, magnet: 95, regen: 0,
+    swivel: 0, chain: false, grapeshot: 0, chase: 0,
+  };
+  e.levels = {};
