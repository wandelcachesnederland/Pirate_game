+  e.prisoners = 0;
+  e.water = e.food = 100;
+  e.maxWater = e.maxFood = 150;
+  e.pickups = [];
+  e.ships = [e.player];
+  e.balls = [];
+  e.texts = [];
+  e.volleys = [];
+  e.banner = { t: 99 };
+  e.addText = vi.fn();
+  e.fxSparkle = vi.fn();
+  e.addTrauma = vi.fn();
+  e.emit = vi.fn();
+  e.volAt = () => 1;
+  e.panAt = () => 0;
+  return e;
+}
+
+describe('real engine tutorial', () => {
+  it('borrows the practice hull and restores the player’s chosen era on exit', () => {
+    const e = shell();
+    e.eraId = 'aztec';
+    e.regionId = 'texcoco';
+    e.buildWaterPatterns = vi.fn();
+    e.startGame = vi.fn((practiceRun: boolean) => { e.tutorial = practiceRun; });
+    e.setTutorialChapter = vi.fn();
+    e.sfx = { stopMusic: vi.fn(), duck: vi.fn() };
+    e.enterMenu = vi.fn();
+
+    e.startTutorial();
+    expect(e.startGame).toHaveBeenCalledWith(true);
+    expect(e.eraId).toBe('golden');
+    expect(e.regionId).toBe('caribbean');
+    expect(e.setTutorialChapter).toHaveBeenCalledWith('helm');
+    e.startTutorial(); // Restarting practice must not overwrite the chosen era.
+    expect(e.startGame).toHaveBeenCalledTimes(2);
+
+    e.quitToMenu();
+    expect(e.eraId).toBe('aztec');
+    expect(e.playerDef).toBe(ERA_FLAGSHIPS.aztec);
+    expect(e.regionId).toBe('texcoco');
+    expect(e.tutorial).toBe(false);
+    expect(e.enterMenu).toHaveBeenCalledOnce();
+  });
+
+  it('stages physical ships for both broadsides and a safe, boardable prize', () => {
+    const e = practice();
+    e.setTutorialChapter('broadsides');
+    expect(e.ships).toHaveLength(3);
+    expect(e.ships.slice(1).map((s: { y: number }) => s.y)).toEqual([-155, 155]);
+    expect(e.ships[1].cannons).toBe(0);
+    e.raiseWhiteFlag = vi.fn((ship: { surrendered: boolean }) => { ship.surrendered = true; });
+    e.capturePrize = vi.fn();
+    e.setTutorialChapter('boarding');
+    expect(e.getBoardCandidate()?.name).toBe('Merchant Fluyt');
+    vi.spyOn(Math, 'random').mockReturnValue(0); // normally an ambush
+    e.resolveBoarding(e.ships[1]);
+    expect(e.capturePrize).toHaveBeenCalledOnce();
+    expect(e.capturePrize).toHaveBeenCalledWith(e.ships[1], expect.any(Number), false);
+  });
+
+  it('steers around real island shallows without damaging the practice hull', () => {
+    const e = practice();
+    e.islands = [{
+      x: 600, y: 0, r: 200, maxR: 200, harm: [],
+      settlement: { inhabited: true, fortress: { hp: 100 } },
+    }];
+    e.player.maxSpeed = 195;
+    e.player.turnRate = 2.05;
+    e.player.slowTimer = 0;
+    e.windFactor = () => 1;
+    e.fxSand = vi.fn();
+    e.sfx.thud = vi.fn();
+    e.hurtPlayer = vi.fn((damage: number) => { e.player.hp -= damage; });
+    e.setTutorialChapter('wind');
+    const startX = e.player.x;
+    e.playTutorialDemo();
+    for (let frame = 0; frame < 90 && e.tutorialDemo; frame++) {
+      e.updateTutorialDemo(0.05);
+      e.shipPhysics(e.player, 0.05);
+      e.shipTerrain(e.player, 0.05);
+    }
+    expect(e.player.x).toBeGreaterThan(startX + 80);
+    expect(e.player.angle).toBeLessThan(-0.1); // bears away from the shore
+    expect(e.tutorialComplete).toBe(true);
+    expect(e.hurtPlayer).not.toHaveBeenCalled();
+    expect(e.getTutorialStatus().hull).toBe(100);
+  });
+
+  it('the computer fires through the normal port and starboard volley rules', () => {
+    const e = practice();
+    e.setTutorialChapter('broadsides');
+    e.playTutorialDemo();
+    expect(e.getTutorialStatus().demonstrating).toBe(true);
+    e.updateTutorialDemo(0.5);
+    expect(e.volleys).toHaveLength(3);
+    expect(e.volleys.every((v: { side: number }) => v.side === -1)).toBe(true);
+    e.updateTutorialDemo(1.5);
+    expect(e.volleys).toHaveLength(6);
+    expect(e.volleys.slice(3).every((v: { side: number }) => v.side === 1)).toBe(true);
+    expect(e.stats.shots).toBe(6);
+    expect(e.getTutorialStatus().completed).toBe(true);
+  });
+
+  it('finishes demonstration actions by wall time on a slow renderer', () => {
+    const e = practice();
+    let clock = 200;
+    vi.spyOn(performance, 'now').mockImplementation(() => clock);
+    e.setTutorialChapter('broadsides');
+    e.playTutorialDemo();
+    // One very late frame: both real side volleys still happen exactly once.
+    clock += 5000;
+    e.updateTutorialDemo(0.05);
+    expect(e.stats.shots).toBe(6);
+    expect(e.volleys).toHaveLength(6);
+    expect(e.getTutorialStatus().demonstrating).toBe(false);
+    expect(e.getTutorialStatus().completed).toBe(true);
+  });
+
+  it('completes the loot demo through actual movement and pickup magnet physics', () => {
+    const e = practice();
+    e.setTutorialChapter('loot');
+    e.player.maxSpeed = 195;
+    e.player.turnRate = 2;
+    e.player.slowTimer = 0;
+    e.windFactor = () => 1;
+    e.playTutorialDemo();
+    // A capped 50ms simulation step, as on a slow browser. Never teleport a
+    // treasure pickup into the ship or directly call collect().
+    for (let frame = 0; frame < 200 && e.tutorialDemo; frame++) {
+      e.updateTutorialDemo(0.05);
+      e.shipPhysics(e.player, 0.05);
+      e.updatePickups(0.05);
+    }
+    expect(e.stats.gold).toBeGreaterThan(0);
+    expect(e.player.hp).toBeGreaterThan(e.player.maxHp - 32);
+    expect(e.tutorialComplete).toBe(true);
+    expect(e.tutorialDemo).toBeNull();
+  });
+
+  it('does not congratulate the learner on treasure until a real repair reaches the hull', () => {
+    const e = practice();
+    e.setTutorialChapter('loot');
+    const repair = e.pickups.find((pk: { kind: number }) => pk.kind === 2);
+    repair.x += 200; // keep the green pickup out of reach while collecting the chest
+    e.player.x = 83;
+    e.updatePickups(0.016);
+    expect(e.stats.gold).toBeGreaterThan(0);
+    expect(e.getTutorialStatus().completed).toBe(false);
+    expect(e.getTutorialStatus().hull).toBe(68);
+
+    e.player.x = repair.x;
+    e.player.y = repair.y;
+    e.updatePickups(0.016);
+    expect(e.getTutorialStatus().completed).toBe(true);
+    expect(e.getTutorialStatus().hull).toBeGreaterThan(68);
