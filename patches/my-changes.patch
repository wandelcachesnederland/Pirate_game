+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { Engine } from '../src/game/engine';
+import { SHIP_DEFS } from '../src/game/data';
+import { DEFAULT_ERA, ERA_FLAGSHIPS } from '../src/game/ships/era';
+import type { EraId, ShipKind } from '../src/game/types';
+
+// Exercise the engine rules without starting its RAF loop or constructing a
+// real canvas. Each test supplies only the world state its rule depends on.
+const shell = (): any => Object.create(Engine.prototype);
+const ship = (kind: ShipKind, countsForWave: boolean, extra = {}) => ({
+  def: SHIP_DEFS[kind], team: 1, sinking: -1, captured: false,
+  countsForWave, peaceful: false, x: 0, y: 0, ...extra,
+});
+
+afterEach(() => vi.restoreAllMocks());
+
+describe('wave objectives', () => {
+  it('counts wave combatants, not village patrols or optional unarmed boats', () => {
+    const e = shell();
+    e.ships = [
+      ship('warCanoe', false), // independently spawned village guard
+      ship('rowboat', false),
+      ship('fishingCanoe', false),
+      ship('brig', true),
+      ship('warCanoe', true), // wave flotilla before breaking off
+      ship('galleon', true, { sinking: 0.1 }),
+      ship('frigate', true, { captured: true }),
+      ship('sloop', false, { team: 0 }),
+    ];
+    expect(e.countEnemies()).toBe(2);
+  });
+
+  it('marks only actual wave combatants during spawning', () => {
+    const e = shell();
+    e.player = { x: 0, y: 0, angle: 0 };
+    e.ships = [];
+    e.wave = 2;
+    e.pointInIsland = () => false;
+    e.anchorNative = vi.fn();
+    e.makeShip = (kind: ShipKind) => ship(kind, false, { sail: 0, sailTarget: 0 });
+
+    for (const kind of ['rowboat', 'fishingCanoe', 'brig', 'warCanoe'] as ShipKind[]) {
+      e.spawnEnemy(kind, 'near');
+    }
+    expect(e.ships.map((s: { countsForWave: boolean }) => s.countsForWave)).toEqual([false, false, true, true]);
+    expect(e.countEnemies()).toBe(2);
+  });
+
+  it('excludes a rescue boat launched from a sinking ship', () => {
+    const e = shell();
+    e.ships = [];
+    e.nextId = 1;
+    e.playerDef = ERA_FLAGSHIPS[DEFAULT_ERA];
+    const sunk = { def: SHIP_DEFS.brig, x: 100, y: 100 };
+    vi.spyOn(Math, 'random').mockReturnValue(0.99);
+    e.launchRowboat(sunk);
+    expect(e.ships).toHaveLength(1);
+    expect(e.ships[0].countsForWave).toBe(false);
+    expect(e.countEnemies()).toBe(0);
+  });
+
+  it('stops counting a wave canoe once it gives up pursuit', () => {
+    const e = shell();
+    e.player = { x: 1000, y: 0 };
+    e.nativeCallTimer = 5;
+    e.steer = vi.fn();
+    const canoe = ship('warCanoe', true, {
+      x: 500, y: 0, vx: 0, vy: 0,
+      homeX: 0, homeY: 0, leash: 400,
+      hunt: 10, beach: -1, nativeState: 'hunt',
+    });
+    e.ships = [canoe];
+    expect(e.countEnemies()).toBe(1);
+    expect(e.nativeBreakOff(canoe, 0.016, 500)).toBe(true);
+    expect(e.ships[0].nativeState).toBe('home');
+    expect(e.countEnemies()).toBe(0);
+  });
+
+  it('clears a wave with only ambient boats remaining', () => {
+    const e = shell();
+    e.ships = [ship('rowboat', false), ship('warCanoe', false)];
+    e.playerDeadTimer = -1;
+    e.waveQueue = [];
+    e.waveClearing = false;
+    e.wave = 1;
+    e.score = 0;
+    e.waveDamage = 1;
+    e.pickups = [];
+    e.sfx = { fanfare: vi.fn() };
+    e.updateWave(0.016, 0.016);
+    expect(e.waveClearing).toBe(true);
+    expect(e.sfx.fanfare).toHaveBeenCalledOnce();
+  });
+});
+
+describe('restart and targeting', () => {
+  it('resets the wave before world generation can scale fort health', () => {
+    const e = shell();
+    e.wave = 15;
+    e.playerDef = ERA_FLAGSHIPS[DEFAULT_ERA];
+    e.sfx = { unlock: vi.fn(), stopMusic: vi.fn(), startMusic: vi.fn(), duck: vi.fn(), setMode: vi.fn() };
+    e.ships = [];
+    e.windAngle = 0;
+    let waveDuringReset = -1;
+    e.resetWorld = () => { waveDuringReset = e.wave; };
+    e.makeShip = () => ({ hp: 100, maxHp: 100, crew: 30, maxCrew: 30, ghostHp: 100 });
+    e.applyPlayerStats = vi.fn();
+    e.input = { clear: vi.fn() };
+    e.cb = { onScreen: vi.fn() };
+    e.startWave = vi.fn();
+    e.startGame();
+    expect(waveDuringReset).toBe(0);
+    expect(e.startWave).toHaveBeenCalledWith(1);
+  });
+
+  it('normalizes invalid eras before selecting a flagship', () => {
+    const e = shell();
+    e.screen = 'playing'; // no menu ship is needed for this rule
+    for (const bad of ['constructor', 'toString', '__proto__', 'not-an-era']) {
+      e.setEra(bad as EraId);
+      expect(e.getEra()).toBe(DEFAULT_ERA);
+      expect(e.playerDef).toBe(ERA_FLAGSHIPS[DEFAULT_ERA]);
+    }
+    e.setEra('aztec');
+    expect(e.getEra()).toBe('aztec');
+    expect(e.playerDef).toBe(ERA_FLAGSHIPS.aztec);
+  });
+
+  it('does not auto-target a nearby peaceful boat over a hostile ship', () => {
+    const e = shell();
+    const player = ship('sloop', false, { team: 0, x: 0, y: 0, angle: 0, range: 400 });
+    const peaceful = ship('fishingCanoe', false, { x: 0, y: 10, peaceful: true });
+    const hostile = ship('brig', true, { x: 0, y: 80 });
+    e.ships = [player, peaceful, hostile];
+    expect(e.findTarget(player, 1)).toBe(hostile);
+    e.ships = [player, peaceful];
+    expect(e.findTarget(player, 1)).toBeNull();
+  });
+});
+
+describe('boarding prisoners', () => {
+  it('records detained prize crew in the inventory and end-of-run stats', () => {
+    const e = shell();
+    e.player = { crew: 30, maxCrew: 40, x: 0, y: 0 };
+    e.stats = { boarded: 0, shots: 0, hits: 0, sunk: 0, gold: 0, maxStreak: 1, time: 25 };
+    e.score = 150;
+    e.wave = 2;
+    e.streakTimer = 0;
+    e.mult = 1;
+    e.goldPopup = 0;
+    e.water = 100;
+    e.maxWater = 150;
+    e.food = 100;
+    e.maxFood = 150;
+    e.prisoners = 0;
+    e.flags = [];
+    e.regionId = 'caribbean';
+    e.sfx = { chest: vi.fn() };
+    e.addScore = vi.fn().mockReturnValue(120);
+    e.addText = vi.fn();
+    e.addPickup = vi.fn();
+    e.fxSparkle = vi.fn();
+    e.addTrauma = vi.fn();
+    e.input = { clear: vi.fn() };
+    e.cb = { onScreen: vi.fn(), onGameOver: vi.fn() };
+    vi.spyOn(Math, 'random').mockReturnValue(0);
+
+    e.capturePrize(ship('brig', true, { crew: 10, x: 40, y: 30 }), 100, false);
+    // Four of ten join (35% rounded); the other six are prisoners.
+    expect(e.getInventory().prisoners).toBe(6);
+    expect(e.addText).toHaveBeenCalledWith(0, -116, '+6 prisoners taken', '#d8c9a3', 14);
+
+    e.gameOver();
+    expect(e.cb.onGameOver).toHaveBeenCalledWith(expect.objectContaining({ prisoners: 6, boarded: 1 }));
+  });
+});
diff --git a/tests/historical-combat.test.ts b/tests/historical-combat.test.ts
