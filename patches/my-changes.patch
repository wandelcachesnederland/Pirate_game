+/** @vitest-environment jsdom */
+import { useState } from 'react';
+import { afterEach, beforeAll, describe, expect, it, vi } from 'vitest';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { EraCarousel } from '../src/components/EraCarousel';
+import type { EraId } from '../src/game/types';
+import { ERA_SHIPS, eraYear } from '../src/game/ships/era';
+
+// The picker uses the game painter for decoration; navigation needs no pixels.
+vi.mock('../src/game/portrait', () => ({
+  paintWater: () => {}, paintWatersPostcard: () => {}, drawPortraitShip: () => {},
+}));
+
+beforeAll(() => {
+  const ctx = new Proxy({}, {
+    get: (_, prop) => prop === 'createLinearGradient'
+      ? () => ({ addColorStop: () => {} })
+      : () => {},
+    set: () => true,
+  });
+  Object.defineProperty(HTMLCanvasElement.prototype, 'getContext', { configurable: true, value: () => ctx });
+  HTMLElement.prototype.scrollTo = () => {};
+  vi.stubGlobal('requestAnimationFrame', () => 1);
+  vi.stubGlobal('cancelAnimationFrame', () => {});
+});
+afterEach(() => cleanup());
+
+function mount() {
+  const chosen: EraId[] = [];
+  function Picker() {
+    const [era, setEra] = useState<EraId>('golden');
+    return <EraCarousel era={era} onEra={(id) => { chosen.push(id); setEra(id); }} />;
+  }
+  render(<Picker />);
+  return chosen;
+}
+
+describe('era picker navigation', () => {
+  it('orders all eras oldest first, including BCE dates, and keeps years visible', () => {
+    expect(ERA_SHIPS.length).toBe(26);
+    expect(ERA_SHIPS.map(eraYear)).toEqual([...ERA_SHIPS.map(eraYear)].sort((a, b) => a - b));
+    expect(ERA_SHIPS[0].year).toBe('1178 BC');
+    expect(ERA_SHIPS.at(-1)?.year).toBe('1988');
+    mount();
+    expect(screen.getByLabelText('Year 1710').textContent).toContain('1710');
+  });
+
+  it('lets the era strip scroll inside a width-constrained chart on phones', () => {
+    mount();
+    const strip = screen.getByRole('tablist', { name: 'Era' });
+    const chart = strip.parentElement!;
+    const grid = chart.parentElement!;
+    // Without min-w-0 the 26 buttons set the grid's min-content width to
+    // ~2,000px and push the chart's year badge below a 360px phone screen.
+    expect(chart.classList.contains('min-w-0')).toBe(true);
+    expect(grid.classList.contains('min-w-0')).toBe(true);
+    expect(grid.lastElementChild?.classList.contains('min-w-0')).toBe(true);
+    expect(strip.classList.contains('overflow-x-auto')).toBe(true);
+  });
+
+  it('advances across two quick arrow presses while the card is still animating', () => {
+    const chosen = mount();
+    const next = screen.getByRole('button', { name: 'Next era' });
+    fireEvent.click(next);
+    fireEvent.click(next);
+    const idx = ERA_SHIPS.findIndex((e) => e.id === 'golden');
+    expect(chosen).toEqual([ERA_SHIPS[idx + 1].id, ERA_SHIPS[idx + 2].id]);
+    expect(screen.getByRole('button', { name: new RegExp(ERA_SHIPS[idx + 2].era) }).getAttribute('aria-pressed')).toBe('true');
+  });
+
+  it('starts the next arrow from a newly clicked slot, not the old card', () => {
+    const chosen = mount();
+    fireEvent.click(screen.getByRole('button', { name: /Ironclad Era/ }));
+    fireEvent.click(screen.getByRole('button', { name: 'Next era' }));
+    expect(chosen).toEqual(['ironclad', ERA_SHIPS[ERA_SHIPS.findIndex((e) => e.id === 'ironclad') + 1].id]);
+  });
+
+  it('uses the latest selection for keyboard arrows too', () => {
+    const chosen = mount();
+    const next = screen.getByRole('button', { name: 'Next era' });
+    fireEvent.keyDown(next, { key: 'ArrowRight' });
+    fireEvent.keyDown(next, { key: 'ArrowRight' });
+    const idx = ERA_SHIPS.findIndex((e) => e.id === 'golden');
+    expect(chosen).toEqual([ERA_SHIPS[idx + 1].id, ERA_SHIPS[idx + 2].id]);
+  });
+});
