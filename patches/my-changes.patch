 const rand = (a: number, b: number) => a + Math.random() * (b - a);
 
@@ -162,3 +162,38 @@ export function moodOf(st: Settlement): Mood {
 export function flagOf(st: Settlement): 'white' | 'red' {
   return st.hostile ? 'red' : 'white';
 }
+
+/** Form neighbourly compacts on the chart: about half the villages have one
+ * or two allies, while the others remain independent. Names identify the pact
+ * to a player; uninhabited and already-hostile shores never join it. */
+export function linkAlliances(islands: readonly Pick<Island, 'x' | 'y' | 'settlement'>[]) {
+  const settled = islands.filter((is) => is.settlement.inhabited && !is.settlement.hostile);
+  for (let i = 0; i + 1 < settled.length; i += 4) {
+    const group = settled.slice(i, i + 4);
+    const first = group[0];
+    const nearest = group.slice(1).sort((a, b) =>
+      Math.hypot(a.x - first.x, a.y - first.y) - Math.hypot(b.x - first.x, b.y - first.y))[0];
+    const pact = `${first.settlement.name} Compact ${Math.floor(i / 4) + 1}`;
+    first.settlement.alliance = pact;
+    nearest.settlement.alliance = pact;
+  }
+}
+
+/** One village's open hostility is a grievance shared by the whole compact.
+ * The player's next provocation resets the allies' own cooldown as well. */
+export function rouseAllies<T extends Pick<Island, 'settlement'>>(
+  islands: readonly T[], origin: T,
+): T[] {
+  const { alliance } = origin.settlement;
+  if (!alliance || !origin.settlement.hostile) return [];
+  const newEnemies: T[] = [];
+  for (const island of islands) {
+    if (island === origin || island.settlement.alliance !== alliance || !island.settlement.inhabited) continue;
+    const st = island.settlement;
+    if (!st.hostile) newEnemies.push(island);
+    st.hostile = true;
+    st.anger = Math.max(st.anger, st.patience);
+    st.calm = 0;
+  }
+  return newEnemies;
+}
