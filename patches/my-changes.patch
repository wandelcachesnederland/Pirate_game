+/** @vitest-environment jsdom */
+import { act, cleanup, render, screen } from '@testing-library/react';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import App from '../src/App';
+import { addScore, loadScores, type ScoreEntry } from '../src/game/storage';
+import type { GameStats, Screen } from '../src/game/types';
+
+const sink = vi.hoisted(() => ({
+  callbacks: null as null | { onScreen: (screen: Screen) => void; onGameOver: (stats: GameStats) => void },
+}));
+vi.mock('../src/game/engine', () => ({
+  Engine: class {
+    input = { touchFireHeld: false, smartQueued: false };
+    constructor(_canvas: HTMLCanvasElement, callbacks: NonNullable<typeof sink.callbacks>) {
+      sink.callbacks = callbacks;
+    }
+    setAudio() {}
+    setEra() {}
+    setRegion() {}
+    destroy() {}
+  },
+}));
+vi.mock('../src/components/StartScreen', () => ({
+  StartScreen: ({ scores }: { scores: ScoreEntry[] }) =>
+    <div data-testid="menu-scores">{scores.map((entry) => entry.score).join(',')}</div>,
+}));
+vi.mock('../src/components/GameOverScreen', () => ({
+  GameOverScreen: ({ scores, rank }: { scores: ScoreEntry[]; rank: number }) =>
+    <div data-testid="gameover-scores">{rank}:{scores.map((entry) => entry.score).join(',')}</div>,
+}));
+
+beforeEach(() => window.localStorage.clear());
+afterEach(() => { cleanup(); window.localStorage.clear(); sink.callbacks = null; });
+
+function otherTabScore(points: number) {
+  const result = addScore({ name: 'Other tab', score: points, wave: 1, sunk: 1, date: Date.now() });
+  // Storage events fire only in *other* windows, not in the one that wrote the
+  // score, so dispatch one to emulate a sibling tab sharing localStorage.
+  act(() => window.dispatchEvent(new StorageEvent('storage', { key: result.key })));
+}
+
+it('refreshes the menu and re-ranks this run on another tab’s new score', () => {
+  render(<App />);
+  expect(screen.getByTestId('menu-scores').textContent).toBe('');
+
+  otherTabScore(100);
+  expect(screen.getByTestId('menu-scores').textContent).toBe('100');
+
+  const stats: GameStats = { score: 300, wave: 2, sunk: 3, gold: 5, accuracy: 0.5, maxStreak: 1, time: 40 };
+  act(() => {
+    sink.callbacks!.onScreen('gameover');
+    sink.callbacks!.onGameOver(stats);
+  });
+  expect(screen.getByTestId('gameover-scores').textContent).toBe('0:300,100');
+
+  otherTabScore(500);
+  expect(screen.getByTestId('gameover-scores').textContent).toBe('1:500,300,100');
+  expect(loadScores().map((entry) => entry.score)).toEqual([500, 300, 100]);
+});
