+import { describe, expect, it, vi } from 'vitest';
+import { Engine } from '../src/game/engine';
+import { coolOff, linkAlliances, patienceFor, provokeBoats, rouseAllies } from '../src/game/settlements';
+import type { Island } from '../src/game/types';
+
+function island(name: string, x: number, y: number, friendliness = 56): Island {
+  return {
+    x, y, maxR: 70,
+    settlement: {
+      inhabited: true, friendliness, name, anger: 0,
+      patience: patienceFor(friendliness), hostile: false, calm: 0,
+    },
+  } as Island;
+}
+
+describe('inhabited-island compacts', () => {
+  it('links neighbours but leaves some villages independent and wilderness out', () => {
+    const a = island('Kona', 0, 0);
+    const b = island('Maui', 100, 0);
+    const c = island('Oahu', 700, 0);
+    const d = island('Kauai', 900, 0);
+    const wild = island('No one', 200, 0);
+    wild.settlement.inhabited = false;
+    const islands = [a, b, c, d, wild];
+    linkAlliances(islands);
+    expect(a.settlement.alliance).toBeTruthy();
+    expect(b.settlement.alliance).toBe(a.settlement.alliance);
+    expect(c.settlement.alliance).toBeUndefined();
+    expect(d.settlement.alliance).toBeUndefined();
+    expect(wild.settlement.alliance).toBeUndefined();
+  });
+
+  it('a provoked village rallies allies, but not neutral neighbours', () => {
+    const [a, b, independent] = [island('A', 0, 0), island('B', 90, 0, 90), island('C', 600, 0)];
+    a.settlement.alliance = b.settlement.alliance = 'Harbour Compact';
+    b.settlement.fortress = { hp: 100, maxHp: 100, timer: 20, ruined: false } as any;
+    const e: any = Object.create(Engine.prototype);
+    e.islands = [a, b, independent];
+    e.onIslandRoused = vi.fn();
+    e.addText = vi.fn();
+    e.provokeIsland(a, 4, 'shell');
+    expect(a.settlement.hostile).toBe(true);
+    expect(b.settlement.hostile).toBe(true);
+    expect(b.settlement.anger).toBeGreaterThanOrEqual(b.settlement.patience);
+    expect(b.settlement.fortress?.timer).toBeLessThan(2);
+    expect(independent.settlement.hostile).toBe(false);
+    expect(e.addText).toHaveBeenCalledWith(expect.any(Number), expect.any(Number),
+      expect.stringContaining('Harbour Compact'), expect.any(String), expect.any(Number));
+    // Not a permanent global faction: each village can eventually stand down.
+    expect(coolOff(b.settlement, 100)).toBe(true);
+    expect(b.settlement.hostile).toBe(false);
+    e.provokeIsland(a, 0.1, 'shell');
+    expect(b.settlement.hostile).toBe(true);
+  });
+
+  it('affectionate villages ignore boat grievances, but answer an ally under fire', () => {
+    const a = island('Trader', 0, 0, 90);
+    const b = island('Defender', 100, 0);
+    a.settlement.alliance = b.settlement.alliance = 'Friendship';
+    expect(provokeBoats(a.settlement, 40)).toBe(false);
+    expect(a.settlement.hostile).toBe(false);
+    b.settlement.hostile = true;
+    const newlyHostile = rouseAllies([a, b], b);
+    expect(newlyHostile).toEqual([a]);
+    expect(a.settlement.hostile).toBe(true);
+  });
+});
diff --git a/tests/islands.test.ts b/tests/islands.test.ts
new file mode 100644
index 0000000..2471019
--- /dev/null
+++ b/tests/islands.test.ts
@@ -0,0 +1,102 @@
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+import { mulberry32, TAU } from '../src/game/math';
+import { buildIsland, islandRadiusAt } from '../src/game/render';
+import { REGIONS, regionById } from '../src/game/worlds';
+import type { RegionId } from '../src/game/types';
+
+// An instrumented canvas is enough to verify baked geometry/feature commands;
+// the browser supplies the actual Path2D and rasterizer when the game runs.
+class FakePath2D { moveTo() {} lineTo() {} closePath() {} }
+let drawing: { op: string; colour: string }[] = [];
+beforeAll(() => {
+  vi.stubGlobal('Path2D', FakePath2D);
+  vi.stubGlobal('document', {
+    createElement: () => {
+      const state = { fillStyle: '', strokeStyle: '' };
+      const ctx = new Proxy(state, {
+        get(target, name) {
+          if (name in target) return target[name as keyof typeof target];
+          return () => {
+            if (['fill', 'fillRect', 'stroke', 'strokeRect', 'clip'].includes(String(name))) {
+              drawing.push({ op: String(name), colour: name === 'stroke' || name === 'strokeRect' ? target.strokeStyle : target.fillStyle });
+            }
+          };
+        },
+        set(target, name, value) {
+          if (name === 'fillStyle' || name === 'strokeStyle') target[name] = String(value);
+          return true;
+        },
+      });
+      return { width: 0, height: 0, getContext: () => ctx };
+    },
+  });
+});
+afterAll(() => vi.unstubAllGlobals());
+
+function paint(id: RegionId, seed = 47) {
+  drawing = [];
+  const is = buildIsland(0, 0, 160, seed, 1, regionById(id).islands);
+  return { is, commands: drawing.slice() };
+}
+
+const specials: [RegionId, string][] = [
+  ['biscay', '#f7f3dc'],            // chalk lighthouse
+  ['mediterranean', '#f0e9d7'],     // stone columns
+  ['aegean', '#f0e9d7'],            // white limestone columns
+  ['bosporus', '#486673'],          // tiled dome
+  ['ionian', '#ad653f'],            // stone watch above olive terraces
+  ['arabian', '#d8bb81'],           // sandstone courtyard
+  ['northSea', '#5c6555'],          // turf longhouse
+  ['chesapeake', '#705838'],        // wooden stilt house
+  ['nileDelta', '#a48356'],         // mudbrick roof
+  ['tonkin', '#5c6b5a'],            // limestone stacks
+  ['inlandSea', '#a93125'],         // shore gate
+  ['koreaStrait', '#a5aa99'],       // stone lookout
+  ['bayOfIslands', '#785b38'],      // palisade
+  ['konaCoast', '#292b2a'],         // black basalt shore
+  ['peruvianCoast', '#eee7cd'],    // guano-white headland
+  ['texcoco', '#5a7535'],          // chinampa gardens
+];
+
+describe('regional island sprites', () => {
+  it('assigns an explicit terrain style to all waters without altering the tropical seas', () => {
+    expect(REGIONS).toHaveLength(22);
+    const tropical = REGIONS.filter((r) => r.islands.style === 'tropical').map((r) => r.id).sort();
+    expect(tropical).toEqual(['bengal', 'caribbean', 'singapore', 'solomons']);
+    expect(REGIONS.every((r) => !!r.islands.style)).toBe(true);
+  });
+
+  it.each(specials)('paints %s with its characteristic feature %s', (id, colour) => {
+    const { commands } = paint(id);
+    expect(commands.some((command) => command.colour === colour)).toBe(true);
+    // Different vegetation and a local house replace the tropical palm ring.
+    const tropical = paint('caribbean').commands;
+    expect(commands).not.toEqual(tropical);
+  });
+
+  it('keeps the seeded original tropical outline and collision radius', () => {
+    const rnd = mulberry32(47);
+    const expected = [
+      { amp: 0.09 + rnd() * 0.08, freq: 2, phase: rnd() * TAU },
+      { amp: 0.05 + rnd() * 0.06, freq: 3, phase: rnd() * TAU },
+      { amp: 0.03 + rnd() * 0.03, freq: 5, phase: rnd() * TAU },
+      { amp: 0.012 + rnd() * 0.015, freq: 9, phase: rnd() * TAU },
+    ];
+    const tropical = paint('caribbean');
+    expect(tropical.is.harm).toEqual(expected);
+    expect(tropical.commands).toEqual(paint('caribbean').commands);
+    expect(paint('northSea').is.harm).not.toEqual(tropical.is.harm);
+    expect(paint('chesapeake').is.harm).not.toEqual(tropical.is.harm);
+    for (const region of REGIONS) {
+      const { is, commands } = paint(region.id);
+      expect(is.shore).toBeInstanceOf(FakePath2D);
+      expect(commands.some((c) => c.op === 'clip')).toBe(true);
+      expect(is.half).toBeCloseTo(is.maxR + 58);
+      for (let i = 0; i < 72; i++) {
+        const radius = islandRadiusAt(is, TAU * i / 72);
+        expect(radius).toBeGreaterThan(0);
+        expect(radius).toBeLessThanOrEqual(is.maxR);
+      }
+    }
+  });
+});
diff --git a/tests/music.test.ts b/tests/music.test.ts
new file mode 100644
index 0000000..264a0a5
--- /dev/null
+++ b/tests/music.test.ts
@@ -0,0 +1,119 @@
+import { describe, expect, it, vi } from 'vitest';
+import { Engine } from '../src/game/engine';
+import { ERA_SHIPS } from '../src/game/ships/era';
+import { ERA_SCORES } from '../src/game/music/eraScores';
+import {
+  BOSS_CASSETTE, bossCassetteForEra, CASSETTES, ERA_PLAYLISTS,
+  playlistForEra, randomCassette, type Deck,
+} from '../src/game/music';
+
+function recordingDeck() {
+  const pitches: number[] = [];
+  const durations: number[] = [];
+  const record = (pitch: number, dur: number) => { pitches.push(pitch); durations.push(dur); };
+  const deck: Deck = {
+    pluck: vi.fn((m, _t, d) => record(m, d)),
+    flute: vi.fn((m, _t, d) => record(m, d)),
+    bell: vi.fn((m, _t, d) => record(m, d)),
+    reed: vi.fn((m, _t, d) => record(m, d)),
+    fiddle: vi.fn((m, _t, d) => record(m, d)),
+    bass: vi.fn((m, _t, d) => record(m, d)),
+    note: vi.fn((_wave, m, _t, d) => record(m, d)),
+    drum: vi.fn(), noise: vi.fn(), stab: vi.fn(), snare: vi.fn(), crash: vi.fn(),
+  };
+  return { deck, pitches, durations };
+}
+
+describe('music for each era', () => {
+  it('keeps every playlist in its own era and each boss in its own waters', () => {
+    expect(Object.keys(ERA_SCORES)).toHaveLength(ERA_SHIPS.length - 1);
+    expect(Object.keys(ERA_PLAYLISTS)).toHaveLength(ERA_SHIPS.length);
+    for (const era of ERA_SHIPS) {
+      const pool = playlistForEra(era.id);
+      expect(pool.length).toBeGreaterThanOrEqual(2);
+      expect(new Set(pool.map((c) => c.title)).size).toBe(pool.length);
+      for (const tape of pool) {
+        if (tape.era) {
+          expect(tape.era).toBe(era.id);
+          expect(tape.region).toBe(era.region);
+        } else {
+          // A few existing maritime tunes also fit these later sailing eras.
+          expect(['golden', 'napoleonic', 'ironclad']).toContain(era.id);
+          expect(CASSETTES).toContain(tape);
+        }
+      }
+      const boss = bossCassetteForEra(era.id);
+      if (era.id === 'golden') expect(boss).toBe(BOSS_CASSETTE);
+      else {
+        expect(boss.era).toBe(era.id);
+        expect(boss.region).toBe(era.region);
+        expect(pool).not.toContain(boss);
+      }
+    }
+    // The same tropical water can carry different eras, but the 1517 Maya
+    // canoe never receives a 1710 pirate shanty.
+    expect(playlistForEra('maya').some((tape) => CASSETTES.includes(tape))).toBe(false);
+  });
+
+  it('changes songs between waves without accidentally choosing another region', () => {
+    const random = vi.spyOn(Math, 'random').mockReturnValue(0);
+    try {
+      for (const era of ERA_SHIPS) {
+        const playlist = playlistForEra(era.id);
+        expect(randomCassette(era.id)).toBe(playlist[0]);
+        const next = randomCassette(era.id, playlist[0]);
+        expect(playlist).toContain(next);
+        expect(next).not.toBe(playlist[0]);
+      }
+    } finally {
+      random.mockRestore();
+    }
+  });
+
+  it('schedules complete looping cues with distinct Chinese, Japanese, Greek and Arab timbres', () => {
+    for (const era of ERA_SHIPS) {
+      const tapes = [...playlistForEra(era.id), bossCassetteForEra(era.id)];
+      for (const tape of tapes) {
+        const { deck, pitches, durations } = recordingDeck();
+        const sd = tape.stepDuration(1);
+        expect(sd).toBeGreaterThan(0);
+        expect(tape.stepDuration(20)).toBeGreaterThan(0);
+        for (let step = 0; step < tape.loopSteps; step++) {
+          tape.playStep(deck, step, step * sd, sd, 1);
+        }
+        expect(pitches.length).toBeGreaterThan(0);
+        expect(pitches.every((m) => Number.isFinite(m) && m >= 20 && m <= 105)).toBe(true);
+        expect(durations.every((d) => Number.isFinite(d) && d > 0)).toBe(true);
+        tape.playStep(deck, 0, 0, sd, 0);
+        tape.playStep(deck, 0, 0, sd, 2);
+      }
+    }
+    for (const era of ['chinese', 'japanese', 'greek', 'arab'] as const) {
+      const { deck } = recordingDeck();
+      const tape = playlistForEra(era)[0];
+      const sd = tape.stepDuration(1);
+      for (let step = 0; step < tape.loopSteps; step++) tape.playStep(deck, step, step * sd, sd, 1);
+      expect(deck.pluck).toHaveBeenCalled();
+      if (era === 'chinese' || era === 'greek' || era === 'arab') expect(deck.flute).toHaveBeenCalled();
+      if (era === 'japanese') expect(deck.bell).toHaveBeenCalled();
+    }
+  });
+
+  it('inserts the chosen era’s song in normal waves and its siege cue on boss waves', () => {
+    const engine: any = Object.create(Engine.prototype);
+    engine.spawnEnemy = vi.fn();
+    engine.sfx = {
+      horn: vi.fn(), setTempo: vi.fn(), insertCassette: vi.fn(), insertRandomCassette: vi.fn(),
+    };
+    for (const era of ERA_SHIPS) {
+      engine.eraId = era.id;
+      engine.sfx.insertRandomCassette.mockClear();
+      engine.sfx.insertCassette.mockClear();
+      engine.startWave(1);
+      expect(engine.sfx.insertRandomCassette).toHaveBeenCalledWith(era.id, false);
+      expect(engine.sfx.insertCassette).not.toHaveBeenCalled();
+      engine.startWave(5);
+      expect(engine.sfx.insertCassette).toHaveBeenCalledWith(bossCassetteForEra(era.id));
+    }
+  });
+});
diff --git a/tests/storage.test.ts b/tests/storage.test.ts
new file mode 100644
index 0000000..37d8dd1
--- /dev/null
+++ b/tests/storage.test.ts
@@ -0,0 +1,85 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+  addScore, clearScores, isScoreStorageKey, loadEra, loadScores, MAX_SCORES,
+  rankForScore, saveEra, type ScoreEntry,
+} from '../src/game/storage';
+import { DEFAULT_ERA, ERA_REGION, eraRegion, isEraId } from '../src/game/ships/era';
+import type { EraId } from '../src/game/types';
+
+class MemoryStorage implements Storage {
+  private data = new Map<string, string>();
+  get length() { return this.data.size; }
+  clear() { this.data.clear(); }
+  getItem(key: string) { return this.data.get(key) ?? null; }
+  key(index: number) { return [...this.data.keys()][index] ?? null; }
+  removeItem(key: string) { this.data.delete(key); }
+  setItem(key: string, value: string) { this.data.set(key, String(value)); }
+}
+
+const score = (points: number): ScoreEntry => ({
+  name: `Captain ${points}`, score: points, wave: 2, sunk: 3, date: 1000 + points,
+});
+let store: MemoryStorage;
+beforeEach(() => {
+  store = new MemoryStorage();
+  vi.stubGlobal('window', { localStorage: store });
+});
+afterEach(() => vi.unstubAllGlobals());
+
+describe('high scores across tabs', () => {
+  it('keeps existing scores readable and writes each new run under a unique key', () => {
+    const old = JSON.stringify([score(100)]);
+    store.setItem('broadside.scores.v1', old);
+    const first = addScore(score(200));
+    const second = addScore(score(300));
+
+    expect(store.getItem('broadside.scores.v1')).toBe(old); // never overwrite an old snapshot
+    expect(first.key).not.toBeNull();
+    expect(second.key).not.toBe(first.key);
+    expect(store.getItem(first.key!)).toBe(JSON.stringify(score(200)));
+    expect(store.getItem(second.key!)).toBe(JSON.stringify(score(300)));
+    expect(loadScores().map((entry) => entry.score)).toEqual([300, 200, 100]);
+    expect(rankForScore(first.key!)).toBe(1);
+
+    // Simulate a second tab saving while this one is still open.
+    const otherKey = 'broadside.scores.entry.v2.other-tab';
+    store.setItem(otherKey, JSON.stringify(score(400)));
+    expect(loadScores().map((entry) => entry.score)).toEqual([400, 300, 200, 100]);
+    expect(rankForScore(first.key!)).toBe(2);
+    expect(isScoreStorageKey(otherKey)).toBe(true);
+    expect(isScoreStorageKey('broadside.captain.v1')).toBe(false);
+  });
+
+  it('prunes out-of-cut records and preserves the top ten', () => {
+    const keys = Array.from({ length: MAX_SCORES + 3 }, (_, i) => addScore(score(i + 1)).key!);
+    expect(loadScores().map(({ score: points }) => points)).toEqual([13, 12, 11, 10, 9, 8, 7, 6, 5, 4]);
+    expect(rankForScore(keys[0])).toBe(-1);
+    expect(rankForScore(keys[keys.length - 1])).toBe(0);
+    expect(Array.from({ length: store.length }, (_, i) => store.key(i)).filter(isScoreStorageKey)).toHaveLength(MAX_SCORES);
+    clearScores();
+    expect(loadScores()).toEqual([]);
+  });
+
+  it('still displays the current result when storage is unavailable', () => {
+    vi.stubGlobal('window', { localStorage: { getItem: () => { throw Error('blocked'); }, setItem: () => { throw Error('blocked'); }, get length() { throw Error('blocked'); } } });
+    const result = addScore(score(50));
+    expect(result).toEqual({ scores: [score(50)], rank: 0, key: null });
+    expect(loadScores()).toEqual([]);
+  });
+});
+
+describe('persisted eras', () => {
+  it('rejects inherited Object keys and unknown values', () => {
+    for (const bad of ['constructor', 'toString', '__proto__', 'not-an-era']) {
+      store.setItem('broadside.era.v1', bad);
+      expect(loadEra()).toBeNull();
+      expect(isEraId(bad)).toBe(false);
+      expect(eraRegion(bad as EraId)).toBe(ERA_REGION[DEFAULT_ERA]);
+      saveEra(bad as EraId);
+      expect(store.getItem('broadside.era.v1')).toBe(bad);
+    }
+    saveEra('aztec');
+    expect(loadEra()).toBe('aztec');
+    expect(eraRegion('aztec')).toBe(ERA_REGION.aztec);
+  });
+});
