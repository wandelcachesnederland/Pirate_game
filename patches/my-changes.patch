+      break;
+    case 'lake': // three straight chinampa garden plots on the lake
+      for (let i = -1; i <= 1; i++) {
+        ctx.fillStyle = '#5a7535';
+        ctx.fillRect(i * s * 0.75 - s * 0.28, -s * 0.85, s * 0.56, s * 1.7);
+        ctx.strokeStyle = '#ae9967';
+        ctx.lineWidth = 1.6;
+        ctx.strokeRect(i * s * 0.75 - s * 0.28, -s * 0.85, s * 0.56, s * 1.7);
+        ctx.strokeStyle = '#b7c173';
+        for (let j = -1; j <= 1; j++) {
+          ctx.beginPath();
+          ctx.moveTo(i * s * 0.75 + j * s * 0.14, -s * 0.6);
+          ctx.lineTo(i * s * 0.75 + j * s * 0.14, s * 0.6);
+          ctx.stroke();
+        }
+      }
+      break;
+    default: break;
+  }
+  ctx.restore();
+}
+
+/** Distinctive terrain, shore plants and one characteristic landmark per island. */
+export function drawRegionalScenery(
+  ctx: CanvasRenderingContext2D,
+  radius: Radius,
+  r: number,
+  theme: IslandTheme,
+  rnd: Rng,
+  inhabited: boolean,
+) {
+  const style = theme.style;
+  if (style === 'tropical') return;
+  if (!flat.has(style)) cliffBands(ctx, radius, r, theme, rnd);
+  if (style === 'lava') {
+    // Black rock around the real shore, clipped by the island outline.
+    ctx.strokeStyle = '#292b2a';
+    ctx.lineWidth = 9;
+    ctx.beginPath();
+    for (let i = 0; i <= 72; i++) {
+      const a = i * TAU / 72;
+      const d = radius(a) - 4;
+      if (i === 0) ctx.moveTo(Math.cos(a) * d, Math.sin(a) * d);
+      else ctx.lineTo(Math.cos(a) * d, Math.sin(a) * d);
+    }
+    ctx.stroke();
+  }
+  if (flat.has(style)) {
+    // Low shores have interlaced mud channels and scattered beds of green,
+    // rather than a mountain or one giant circular forest.
+    for (let i = 0; i < 9; i++) {
+      const x = (rnd() - 0.5) * r * 1.15;
+      const y = (rnd() - 0.5) * r * 1.15;
+      const s = 9 + rnd() * 13;
+      ctx.fillStyle = theme.greens[i % theme.greens.length];
+      if (style === 'marsh') {
+        ctx.beginPath();
+        ctx.ellipse(x, y, s, s * 0.48, rnd() * TAU, 0, TAU);
+        ctx.fill();
+      } else {
+        ctx.save();
+        ctx.translate(x, y);
+        ctx.rotate((rnd() - 0.5) * 0.5);
+        ctx.fillRect(-s, -s * 0.45, s * 2, s * 0.9);
+        ctx.restore();
+      }
+    }
+    ctx.strokeStyle = theme.wetSand;
+    ctx.lineWidth = 3;
+    for (let i = 0; i < 4; i++) {
+      const a = rnd() * TAU;
+      const d = radius(a) * 0.84;
+      ctx.beginPath();
+      ctx.moveTo(Math.cos(a) * d, Math.sin(a) * d);
+      ctx.quadraticCurveTo(Math.cos(a + 0.3) * d * 0.78, Math.sin(a + 0.3) * d * 0.78,
+        Math.cos(a + 0.6) * d * 0.5, Math.sin(a + 0.6) * d * 0.5);
+      ctx.stroke();
+    }
+  }
+  const sparse = dry.has(style) || style === 'chalk' || style === 'aegean';
+  const count = Math.floor(r / (flat.has(style) ? 7 : sparse ? 19 : 11));
+  for (let i = 0; i < count; i++) {
+    const a = rnd() * TAU;
+    const d = radius(a) * (flat.has(style) ? 0.68 + rnd() * 0.21 : 0.47 + rnd() * 0.31);
+    const x = Math.cos(a) * d;
+    const y = Math.sin(a) * d;
+    if (flat.has(style)) reeds(ctx, x, y, rnd, theme);
+    else tree(ctx, style, x, y, 5 + rnd() * 5, theme, rnd);
+  }
+  // The shrine, lighthouse, terraces, karst spires or volcanic fissure is
+  // scenery only; no new obstacle sits outside the collision shore.
+  if (inhabited || style === 'karst' || style === 'lava' || style === 'arid') marker(ctx, style, r, theme, rnd);
+}
+
+/** Local building silhouettes in place of identical Caribbean huts worldwide. */
+export function drawRegionalHouse(ctx: CanvasRenderingContext2D, style: IslandStyle, x: number, y: number, s: number, rot: number) {
+  ctx.save();
+  ctx.translate(x, y);
+  ctx.rotate(rot);
+  ctx.fillStyle = 'rgba(0,0,0,0.2)';
+  ctx.fillRect(-s * 0.5 + 2, -s * 0.45 + 2, s, s * 0.9);
+  const stone = ['limestone', 'aegean', 'ionian', 'bosporus', 'chalk', 'arid'].includes(style);
+  ctx.fillStyle = stone ? '#e6dcc4' : style === 'nordic' ? '#786952' :
+    style === 'japan' || style === 'korea' ? '#d4c7ac' :
+    style === 'lava' ? '#ab9469' : '#b99b69';
+  ctx.fillRect(-s * 0.5, -s * 0.45, s, s * 0.9);
+  if (['desert', 'delta', 'lake', 'arid'].includes(style)) {
+    // Sun-baked, low flat roofs with a roof opening.
+    ctx.fillStyle = '#a48356';
+    ctx.fillRect(-s * 0.25, -s * 0.22, s * 0.5, s * 0.42);
+  } else if (style === 'japan' || style === 'korea') {
+    ctx.fillStyle = style === 'japan' ? '#39433f' : '#4a5052';
+    ctx.beginPath();
+    ctx.moveTo(-s * 0.7, -s * 0.23);
+    ctx.quadraticCurveTo(0, -s * 0.67, s * 0.7, -s * 0.23);
+    ctx.lineTo(s * 0.6, s * 0.28);
+    ctx.quadraticCurveTo(0, s * 0.42, -s * 0.6, s * 0.28);
+    ctx.fill();
+    ctx.strokeStyle = '#ddd1aa';
+    ctx.lineWidth = 1;
+    ctx.beginPath(); ctx.moveTo(-s * 0.6, 0); ctx.lineTo(s * 0.6, 0); ctx.stroke();
+  } else if (style === 'nordic' || style === 'fern') {
+    ctx.fillStyle = style === 'nordic' ? '#495c43' : '#82623f';
+    ctx.fillRect(-s * 0.6, -s * 0.3, s * 1.2, s * 0.6);
+    ctx.strokeStyle = '#aa9164';
+    ctx.strokeRect(-s * 0.6, -s * 0.3, s * 1.2, s * 0.6);
+  } else if (style === 'marsh' || style === 'karst') {
+    ctx.fillStyle = '#705838';
+    ctx.fillRect(-s * 0.64, -s * 0.55, s * 1.28, s * 0.22);
+    ctx.fillRect(-s * 0.42, s * 0.45, s * 0.12, s * 0.35);
+    ctx.fillRect(s * 0.3, s * 0.45, s * 0.12, s * 0.35);
+  } else {
+    ctx.fillStyle = style === 'lava' ? '#70543a' : '#a9613b';
+    ctx.fillRect(-s * 0.6, -s * 0.37, s * 1.2, s * 0.3);
+    ctx.fillStyle = '#6b4d39';
+    ctx.fillRect(-s * 0.5, s * 0.06, s, s * 0.1);
+  }
+  ctx.restore();
+}
