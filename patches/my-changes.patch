@@ -0,0 +1,41 @@
+import type { EraId, ShipDef } from './types';
+
+export type Weapon = NonNullable<ShipDef['weapon']>;
+
+/** Gunpowder appears at different times in different waters; year alone is not enough. */
+export const ANCIENT_WEAPONS: Partial<Record<EraId, Weapon>> = {
+  egypt: 'arrow', greek: 'arrow', roman: 'bolt', macedon: 'bolt',
+  byzantium: 'fire', viking: 'arrow', chola: 'arrow', arab: 'arrow',
+  vietnam: 'arrow', inca: 'arrow', maya: 'arrow', aztec: 'arrow',
+};
+
+/** A ballista/catapult is wound by a winch and pulleys, not fired by powder. */
+export function weaponFor(era: EraId, def: ShipDef): Weapon {
+  if (def.weapon) return def.weapon;
+  const ancient = ANCIENT_WEAPONS[era];
+  if (!ancient) return def.powered ? 'shell' : 'cannon';
+  // Spanish brigantines and caravels at first contact really DID have guns.
+  if (def.faction === 'spain' || def.faction === 'england' || def.faction === 'france') return 'cannon';
+  if (era === 'byzantium' && def.kind !== 'player') return 'bolt';
+  // Only the hero's Byzantine dromon carries the incendiary siphon.
+  if (ancient === 'fire' && def.faction !== 'byzantium' && def.kind !== 'player') return 'bolt';
+  if (era === 'viking' && def.kind === 'vikingJarl') return 'bolt';
+  return ancient;
+}
+
+export function gunpowderWeapon(w: Weapon): boolean {
+  return w === 'cannon' || w === 'shell';
+}
+
+/** UI descriptions never advertise cannons, smoke or grape on ancient craft. */
+export function weaponLabel(w: Weapon): string {
+  switch (w) {
+    case 'arrow': return 'ARCHERS';
+    case 'bolt': return 'WINCH BOLTS';
+    case 'fire': return 'GREEK FIRE';
+    case 'shell': return 'NAVAL GUNS';
+    case 'torpedo': return 'TORPEDOES';
+    case 'missile': return 'MISSILES';
+    default: return 'CANNONS';
+  }
+}
