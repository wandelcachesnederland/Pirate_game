@@ -0,0 +1,152 @@
+import { useEffect, useState, type KeyboardEvent as ReactKeyboardEvent } from 'react';
+import { BookOpen, ChevronDown, ChevronLeft, ChevronRight, ChevronUp, House, Pause, Play, RotateCcw } from 'lucide-react';
+import type { Engine } from '../game/engine';
+import { TUTORIAL_CHAPTERS, type TutorialStatus } from '../game/tutorial';
+
+type Props = {
+  engine: Engine;
+  screen: 'playing' | 'upgrade';
+  onExit: () => void;
+  onPause: () => void;
+};
+
+/** The lesson is an overlay, not a replacement for the live engine or its controls. */
+export function TutorialOverlay({ engine, screen, onExit, onPause }: Props) {
+  const [status, setStatus] = useState<TutorialStatus | null>(() => engine.getTutorialStatus());
+  const [minimized, setMinimized] = useState(false);
+  const [expandAfterDemo, setExpandAfterDemo] = useState(false);
+  useEffect(() => {
+    const id = window.setInterval(() => setStatus(engine.getTutorialStatus()), 150);
+    return () => window.clearInterval(id);
+  }, [engine]);
+  useEffect(() => {
+    if (expandAfterDemo && status && !status.demonstrating) {
+      setMinimized(false);
+      setExpandAfterDemo(false);
+    }
+  }, [expandAfterDemo, status?.demonstrating]);
+
+  const index = Math.max(0, TUTORIAL_CHAPTERS.findIndex((c) => c.id === status?.chapter));
+  const chapter = TUTORIAL_CHAPTERS[index];
+  const changeChapter = (next: number) => {
+    const destination = TUTORIAL_CHAPTERS[next];
+    if (!destination) return;
+    engine.setTutorialChapter(destination.id);
+    setMinimized(false);
+    setExpandAfterDemo(false);
+    setStatus(engine.getTutorialStatus());
+  };
+  const reset = () => {
+    engine.setTutorialChapter(chapter.id);
+    setMinimized(false);
+    setExpandAfterDemo(false);
+    setStatus(engine.getTutorialStatus());
+  };
+  const watch = () => {
+    engine.playTutorialDemo();
+    setStatus(engine.getTutorialStatus());
+    setMinimized(true); // leave the real ship unobstructed during the example
+    setExpandAfterDemo(true);
+  };
+  // Space activates a focused tutorial button, not a broadside behind it.
+  const onPanelKeyDown = (event: ReactKeyboardEvent) => {
+    if (event.code === 'Space' && event.target instanceof HTMLButtonElement) event.stopPropagation();
+    if ((event.code === 'ArrowUp' || event.code === 'ArrowDown') &&
+        event.target instanceof HTMLDivElement && event.target.classList.contains('tutorial-lesson')) event.stopPropagation();
+  };
+
+  if (screen === 'upgrade') {
+    return (
+      <div className="tutorial-overlay" onKeyDown={onPanelKeyDown}>
+        <aside className="tutorial-upgrade arcade-panel arcade-noscan" role="region" aria-label="Captain's tutorial">
+          <span className="arcade-tag">Lesson {index + 1}/{TUTORIAL_CHAPTERS.length} · Live Shipwright</span>
+          <span>Pick a real upgrade: click a card, tap it, or press 1, 2 or 3.</span>
+          <div className="tutorial-upgrade-actions">
+            <button type="button" onClick={() => changeChapter(index - 1)}>◂ Back</button>
+            <button type="button" onClick={() => changeChapter(index + 1)}>Skip ▸</button>
+            <button type="button" onClick={onExit}>Exit tutorial</button>
+          </div>
+        </aside>
+      </div>
+    );
+  }
+
+  if (minimized) {
+    return (
+      <div className="tutorial-overlay" onKeyDown={onPanelKeyDown}>
+        <aside className="tutorial-minimized arcade-panel arcade-noscan" role="region" aria-label="Captain's tutorial">
+          <strong>Lesson {index + 1}: {chapter.title}</strong>
+          <span>{status?.demonstrating ? 'Watch the ship in action…' : 'Your turn — give it a try!'}</span>
+          <button type="button" onClick={() => { setMinimized(false); setExpandAfterDemo(false); }}>
+            <ChevronDown size={16} aria-hidden="true" /> Show instructions
+          </button>
+          <button type="button" onClick={onExit} aria-label="Exit tutorial"><House size={17} /></button>
+        </aside>
+      </div>
+    );
+  }
+
+  return (
+    <div className="tutorial-overlay" onKeyDown={onPanelKeyDown}>
+      <aside className="tutorial-panel arcade-panel arcade-noscan" role="region" aria-label="Captain's tutorial">
+        <div className="tutorial-topline">
+          <span className="arcade-tag"><BookOpen aria-hidden="true" size={16} /> Captain&apos;s Tutorial</span>
+          <div className="tutorial-top-actions">
+            <button type="button" onClick={() => setMinimized(true)} aria-label="Hide instructions" title="Hide instructions"><ChevronUp size={17} /></button>
+            <button type="button" onClick={onPause} aria-label="Pause tutorial" title="Pause (P or Esc)"><Pause size={17} /></button>
+            <button type="button" onClick={onExit} aria-label="Exit tutorial" title="Return to port"><House size={17} /></button>
+          </div>
+        </div>
+        <div className="tutorial-progress" aria-label={`Lesson ${index + 1} of ${TUTORIAL_CHAPTERS.length}`}>
+          {TUTORIAL_CHAPTERS.map((c, i) => (
+            <span key={c.id} className={i === index ? 'is-current' : i < index ? 'is-done' : ''} aria-hidden="true" />
+          ))}
+        </div>
+        <div className="tutorial-lesson" tabIndex={0} aria-label="Lesson instructions — scroll for more" aria-live="polite" aria-atomic="true">
+          <span className="tutorial-step">Lesson {index + 1} / {TUTORIAL_CHAPTERS.length} · Practice waters</span>
+          <h2>{chapter.title}</h2>
+          <p className={`tutorial-task${status?.completed ? ' is-complete' : ''}`}>
+            {status?.completed ? '✓ Well done! Try again, or continue.' : `Your turn: ${chapter.task}`}
+          </p>
+          <p>{chapter.description}</p>
+          <p className="tutorial-example"><strong>Live example:</strong> {chapter.example}</p>
+          <p className="tutorial-keys">{chapter.keys}</p>
+        </div>
+        <span className="tutorial-scroll-hint" aria-hidden="true">↓ Swipe the lesson text for more</span>
+        <dl className="tutorial-stats" aria-label="Live ship readings">
+          <div><dt>Hull</dt><dd>{status?.hull ?? 100}% <small>({status?.maxHull ?? 100} HP)</small></dd></div>
+          <div><dt>Sails</dt><dd>{status?.sails ?? 0}%</dd></div>
+          <div><dt>Guns / side</dt><dd>{status?.guns ?? 3}</dd></div>
+          <div><dt>Gold</dt><dd>{status?.gold.toLocaleString() ?? '0'}</dd></div>
+          {chapter.id === 'broadsides' || chapter.id === 'smart' ? (
+            <div className="tutorial-wide"><dt>Reload</dt><dd>Port {status?.portReload ?? 0}s · Starboard {status?.starboardReload ?? 0}s</dd></div>
+          ) : null}
+          {chapter.id === 'boarding' || chapter.id === 'orders' ? (
+            <div className="tutorial-wide"><dt>Company</dt><dd>{status?.crew ?? 0} crew · {status?.prisoners ?? 0} prisoners · {status?.boarded ?? 0} prizes</dd></div>
+          ) : null}
+        </dl>
+        <div className="tutorial-buttons">
+          {chapter.demo && (
+            <button type="button" className="tutorial-watch" onClick={watch} disabled={status?.demonstrating}>
+              <Play size={17} aria-hidden="true" /> {status?.demonstrating ? 'Captain at the helm…' : 'Watch the captain'}
+            </button>
+          )}
+          <button type="button" className="tutorial-reset" onClick={reset}><RotateCcw size={15} aria-hidden="true" /> Reset example</button>
+        </div>
+        <div className="tutorial-navigation">
+          <button type="button" onClick={() => changeChapter(index - 1)} disabled={index === 0}>
+            <ChevronLeft size={16} aria-hidden="true" /> Back
+          </button>
+          <span>{index + 1} / {TUTORIAL_CHAPTERS.length}</span>
+          {index === TUTORIAL_CHAPTERS.length - 1 ? (
+            <button type="button" onClick={onExit}>Return to port <House size={15} aria-hidden="true" /></button>
+          ) : (
+            <button type="button" onClick={() => changeChapter(index + 1)}>
+              Next lesson <ChevronRight size={16} aria-hidden="true" />
+            </button>
+          )}
+        </div>
+      </aside>
+    </div>
+  );
+}
