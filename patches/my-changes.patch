+++ b/tests/historical-combat.test.ts
@@ -0,0 +1,154 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { Engine } from '../src/game/engine';
+import { SHIP_DEFS, waveCompositionFor } from '../src/game/data';
+import { ERA_FLAGSHIPS, ERA_SHIPS, eraYear } from '../src/game/ships/era';
+import { ERA_ROSTERS } from '../src/game/rosters';
+import { REGIONS } from '../src/game/worlds';
+import { ANCIENT_WEAPONS, gunpowderWeapon, weaponFor } from '../src/game/weapons';
+import type { EraId, Island, ShipKind } from '../src/game/types';
+
+const shell = (): any => Object.create(Engine.prototype);
+afterEach(() => vi.restoreAllMocks());
+
+// The real engine volley, not just a text label or a separate simulation.
+function volley(eraId: EraId, def = ERA_FLAGSHIPS[eraId], side = 1) {
+  const e = shell();
+  const s = {
+    id: 1, def, x: 0, y: 0, vx: 0, vy: 0, angle: 0, team: 0,
+    range: def.range, ballSpeed: def.ballSpeed, aiJitter: 0,
+    recoilL: 0, recoilR: 0,
+  };
+  e.eraId = eraId;
+  e.pstats = { chain: false };
+  e.balls = [];
+  e.ships = [s];
+  e.kickX = e.kickY = 0;
+  e.findTarget = vi.fn(() => null);
+  e.fxMuzzle = vi.fn();
+  e.emit = vi.fn();
+  e.addTrauma = vi.fn();
+  e.volAt = () => 1;
+  e.panAt = () => 0;
+  e.sfx = { cannon: vi.fn(), launch: vi.fn() };
+  e.fireCannon({ ship: s, side, lx: 0, rel: side * Math.PI / 2, dmg: def.damage });
+  return e;
+}
+
+describe('period fleets and their real projectiles', () => {
+  it('lists every era in historical order with regions, waves and scores', () => {
+    expect(ERA_SHIPS).toHaveLength(26);
+    expect(ERA_SHIPS.map(eraYear)).toEqual([...ERA_SHIPS.map(eraYear)].sort((a, b) => a - b));
+    for (const era of ERA_SHIPS) {
+      expect(REGIONS.some((r) => r.id === era.region)).toBe(true);
+      expect(ERA_FLAGSHIPS[era.id]).toBe(era.def);
+      const roster = ERA_ROSTERS[era.id];
+      expect(roster.early).toHaveLength(5);
+      for (let n = 1; n <= 10; n++) {
+        for (const kind of waveCompositionFor(era.id, n)) {
+          expect(SHIP_DEFS[kind], `${era.id} wave ${n}: ${kind}`).toBeDefined();
+        }
+      }
+    }
+  });
+
+  it('Viking foes are longships and knarrs, not galleons with cannons', () => {
+    expect(ERA_ROSTERS.viking.early.flat().every((k) =>
+      (['vikingRaider', 'vikingKnarr', 'vikingJarl'] as ShipKind[]).includes(k))).toBe(true);
+    expect(SHIP_DEFS.vikingRaider.weapon).toBe('arrow');
+    expect(SHIP_DEFS.vikingJarl.weapon).toBe('bolt');
+  });
+
+  it('archers, pulley-wound bolts and Greek fire never spawn round shot or gun smoke', () => {
+    for (const [id, weapon] of Object.entries(ANCIENT_WEAPONS)) {
+      const e = volley(id as EraId);
+      expect(e.balls[0].weapon).toBe(weapon);
+      expect(gunpowderWeapon(e.balls[0].weapon)).toBe(false);
+      expect(e.fxMuzzle).not.toHaveBeenCalled();
+      expect(e.sfx.cannon).not.toHaveBeenCalled();
+      expect(e.sfx.launch).toHaveBeenCalledWith(weapon, expect.any(Number), expect.any(Number));
+    }
+    // Spanish brigantines in 1521 had guns; Aztec canoes did not.
+    expect(weaponFor('aztec', SHIP_DEFS.spanBrigantine)).toBe('cannon');
+    expect(weaponFor('aztec', ERA_FLAGSHIPS.aztec)).toBe('arrow');
+    expect(weaponFor('maya', SHIP_DEFS.conqCaravel)).toBe('cannon');
+  });
+
+  it('the four new conflicts have their own opponents, propulsion and armament', () => {
+    for (const id of ['barbary', 'ww1', 'ww2', 'hormuz'] as const) {
+      expect(ERA_ROSTERS[id].early.flat().some((k) => SHIP_DEFS[k].boss)).toBe(true);
+      expect(ERA_ROSTERS[id].early.flat().some((k) => SHIP_DEFS[k].faction !== 'pirate')).toBe(true);
+    }
+    expect(weaponFor('barbary', ERA_FLAGSHIPS.barbary)).toBe('cannon');
+    expect(ERA_FLAGSHIPS.ww1.powered).toBe(true);
+    expect(ERA_FLAGSHIPS.ww2.weapon).toBe('shell');
+    expect(ERA_FLAGSHIPS.hormuz.weapon).toBe('missile');
+    for (const id of ['ww1', 'ww2', 'hormuz'] as const) {
+      expect(ERA_FLAGSHIPS[id].masts).toBe(0);
+      expect(volley(id).balls[0].weapon).toBe(ERA_FLAGSHIPS[id].weapon);
+    }
+    expect(ERA_ROSTERS.hormuz.early.flat()).not.toContain('gulfTanker');
+    expect(ERA_ROSTERS.hormuz.pool.some((e) => e.kind === 'gulfTanker')).toBe(false);
+  });
+
+  it('WWII torpedoes are limited, unguided and exclude peaceful tankers', () => {
+    const e = shell();
+    const def = ERA_FLAGSHIPS.ww2;
+    e.eraId = 'ww2';
+    e.screen = 'playing';
+    e.torpedoes = 3;
+    e.torpedoCd = 0;
+    e.stats = { shots: 0 };
+    e.player = { def, x: 0, y: 0, angle: 0, vx: 0, vy: 0 };
+    e.ships = [
+      { def: SHIP_DEFS.gulfTanker, x: 30, y: 0, team: 1, peaceful: true, sinking: -1 },
+      { def: SHIP_DEFS.ww2Destroyer, x: 250, y: 50, team: 1, peaceful: false, surrendered: false, sinking: -1 },
+    ];
+    e.balls = [];
+    e.fxSplash = vi.fn(); e.addText = vi.fn();
+    e.sfx = { launch: vi.fn() };
+    e.panAt = () => 0;
+    e.fireTorpedo();
+    expect(e.balls).toHaveLength(1);
+    expect(e.balls[0].weapon).toBe('torpedo');
+    expect(e.balls[0].targetId).toBeUndefined();
+    expect(e.torpedoes).toBe(2);
+    expect(e.stats.shots).toBe(1);
+    e.fireTorpedo();
+    expect(e.balls).toHaveLength(1);
+  });
+
+  it('enemy WWI torpedo boats carry period tubes as well as naval guns', () => {
+    const e = shell();
+    e.balls = [];
+    e.playerDeadTimer = -1;
+    e.player = { x: 240, y: 0, vx: 0, vy: 0 };
+    e.fxSplash = vi.fn();
+    e.volAt = () => 1; e.panAt = () => 0;
+    e.sfx = { launch: vi.fn() };
+    const boat = { def: SHIP_DEFS.ww1TorpedoBoat, x: 0, y: 0, torpedoTimer: 0 };
+    e.enemyTorpedo(boat, 240, 0.1);
+    expect(e.balls[0].weapon).toBe('torpedo');
+    expect(e.balls[0].team).toBe(1);
+    expect(boat.torpedoTimer).toBeGreaterThan(0);
+  });
+});
+
+describe('period-appropriate archipelago craft', () => {
+  it('modern islands launch motor patrols, Viking villages launch longships', () => {
+    for (const [id, expected] of [
+      ['ww2', 'fishingLaunch'], ['hormuz', 'fishingLaunch'], ['viking', 'fishingKnarr'],
+    ] as [EraId, ShipKind][]) {
+      const e = shell();
+      e.player = { def: ERA_FLAGSHIPS[id] };
+      e.eraId = id;
+      e.wave = 1;
+      e.pointInIsland = () => false;
+      e.anchorNative = vi.fn();
+      e.ships = [];
+      e.makeShip = vi.fn((kind: ShipKind) => ({ def: SHIP_DEFS[kind], x: 0, y: 0 }));
+      e.launchFishingBoat({ x: 100, y: 20, maxR: 65 } as Island);
+      expect(e.makeShip).toHaveBeenCalledWith(expected, expect.any(Number), expect.any(Number), expect.any(Number));
+      expect(e.ships[0].peaceful).toBe(true);
+    }
+  });
+});
