+// Region-specific scenery baked into island sprites. Everything here is paint:
+// the shore Path2D and islandRadiusAt in render.ts remain the collision truth.
+// All placements use the island's seeded RNG so portraits and gameplay agree.
+import { TAU } from './math';
+import type { IslandStyle, IslandTheme } from './worlds';
+
+type Rng = () => number;
+type Radius = (angle: number) => number;
+const flat = new Set<IslandStyle>(['marsh', 'delta', 'lake']);
+const dry = new Set<IslandStyle>(['desert', 'arid', 'lava']);
+
+function cliffBands(ctx: CanvasRenderingContext2D, radius: Radius, r: number, theme: IslandTheme, rnd: Rng) {
+  for (let i = 0; i < 2 + Math.floor(r / 65); i++) {
+    const a = rnd() * TAU;
+    const span = 0.35 + rnd() * 0.55;
+    const w = r * (0.07 + rnd() * 0.07);
+    ctx.beginPath();
+    for (let k = 0; k <= 9; k++) {
+      const aa = a + span * k / 9;
+      const d = radius(aa) - 3;
+      if (k === 0) ctx.moveTo(Math.cos(aa) * d, Math.sin(aa) * d);
+      else ctx.lineTo(Math.cos(aa) * d, Math.sin(aa) * d);
+    }
+    for (let k = 9; k >= 0; k--) {
+      const aa = a + span * k / 9;
+      const d = radius(aa) - w;
+      ctx.lineTo(Math.cos(aa) * d, Math.sin(aa) * d);
+    }
+    ctx.closePath();
+    ctx.fillStyle = theme.peaks[i % 2];
+    ctx.fill();
+    // An uneven pale ledge distinguishes cliffs from a plain colour band.
+    ctx.strokeStyle = theme.peaks[2];
+    ctx.lineWidth = 1.5;
+    ctx.beginPath();
+    for (let k = 0; k <= 7; k++) {
+      const aa = a + span * k / 7;
+      const d = radius(aa) - w * (0.83 + 0.09 * Math.sin(k * 3 + i));
+      if (k === 0) ctx.moveTo(Math.cos(aa) * d, Math.sin(aa) * d);
+      else ctx.lineTo(Math.cos(aa) * d, Math.sin(aa) * d);
+    }
+    ctx.stroke();
+  }
+}
+
+function tree(ctx: CanvasRenderingContext2D, style: IslandStyle, x: number, y: number, s: number, theme: IslandTheme, rnd: Rng) {
+  ctx.save();
+  ctx.translate(x, y);
+  ctx.rotate(rnd() * TAU);
+  ctx.fillStyle = 'rgba(0, 0, 0, 0.19)';
+  ctx.beginPath();
+  ctx.ellipse(s * 0.22, s * 0.25, s * 0.86, s * 0.65, 0, 0, TAU);
+  ctx.fill();
+  if (style === 'nordic' || style === 'japan' || style === 'korea') {
+    // Three dark, pointed tiers of a coastal pine viewed from above.
+    ctx.fillStyle = theme.palmTrunk;
+    ctx.fillRect(-s * 0.14, -s * 0.14, s * 0.28, s * 0.28);
+    for (let ring = 0; ring < 2; ring++) {
+      ctx.fillStyle = ring ? theme.palmLight : theme.palmDark;
+      for (let k = 0; k < 8; k++) {
+        const a = (k / 8) * TAU + ring * 0.25;
+        const length = s * (ring ? 0.7 : 1.05);
+        ctx.beginPath();
+        ctx.moveTo(-Math.sin(a) * s * 0.23, Math.cos(a) * s * 0.23);
+        ctx.lineTo(Math.cos(a) * length, Math.sin(a) * length);
+        ctx.lineTo(Math.sin(a) * s * 0.23, -Math.cos(a) * s * 0.23);
+        ctx.fill();
+      }
+    }
+  } else if (style === 'limestone' || style === 'aegean' || style === 'ionian') {
+    // Low silvery olive crowns, rather than Caribbean palms.
+    ctx.fillStyle = theme.palmDark;
+    ctx.beginPath();
+    ctx.ellipse(0, 0, s * 0.85, s * 0.72, 0, 0, TAU);
+    ctx.fill();
+    ctx.fillStyle = theme.peaks[2];
+    for (let k = 0; k < 5; k++) {
+      const a = (k / 5) * TAU;
+      ctx.beginPath();
+      ctx.arc(Math.cos(a) * s * 0.43, Math.sin(a) * s * 0.38, s * 0.19, 0, TAU);
+      ctx.fill();
+    }
+  } else if (style === 'bosporus') {
+    // Tall, narrow cypress shadows along the strait.
+    ctx.fillStyle = theme.palmDark;
+    ctx.beginPath();
+    ctx.ellipse(0, 0, s * 0.42, s * 1.2, 0, 0, TAU);
+    ctx.fill();
+    ctx.fillStyle = theme.palmLight;
+    ctx.beginPath();
+    ctx.ellipse(-s * 0.09, -s * 0.16, s * 0.18, s * 0.85, 0, 0, TAU);
+    ctx.fill();
+  } else if (style === 'desert') {
+    // A few thin date fronds around a sandy trunk, not dense jungle.
+    ctx.fillStyle = theme.palmTrunk;
+    ctx.beginPath();
+    ctx.arc(0, 0, s * 0.17, 0, TAU);
+    ctx.fill();
+    for (let k = 0; k < 7; k++) {
+      const a = (k / 7) * TAU;
+      ctx.strokeStyle = k % 2 ? theme.palmDark : theme.palmLight;
+      ctx.lineWidth = 2;
+      ctx.beginPath();
+      ctx.moveTo(0, 0);
+      ctx.quadraticCurveTo(Math.cos(a) * s * 0.6, Math.sin(a) * s * 0.6,
+        Math.cos(a + 0.2) * s, Math.sin(a + 0.2) * s);
+      ctx.stroke();
+    }
+  } else if (style === 'fern') {
+    // Tree-fern whorls of the Bay of Islands.
+    ctx.fillStyle = theme.palmTrunk;
+    ctx.beginPath();
+    ctx.arc(0, 0, s * 0.16, 0, TAU);
+    ctx.fill();
+    for (let k = 0; k < 8; k++) {
+      const a = (k / 8) * TAU;
+      ctx.strokeStyle = k % 2 ? theme.palmDark : theme.palmLight;
+      ctx.lineWidth = 1.8;
+      ctx.beginPath();
+      ctx.moveTo(0, 0);
+      ctx.lineTo(Math.cos(a) * s, Math.sin(a) * s);
+      ctx.stroke();
+      for (let j = 1; j <= 3; j++) {
+        const d = s * j / 4;
+        ctx.fillStyle = theme.palmLight;
+        ctx.beginPath();
+        ctx.ellipse(Math.cos(a) * d, Math.sin(a) * d, s * 0.19, s * 0.1, a, 0, TAU);
+        ctx.fill();
+      }
+    }
+  } else if (style === 'karst') {
+    // Sparse bamboo copses tucked between limestone stacks.
+    ctx.strokeStyle = theme.palmDark;
+    ctx.lineWidth = 2;
+    for (let k = -2; k <= 2; k++) {
+      ctx.beginPath();
+      ctx.moveTo(k * 2, s * 0.65);
+      ctx.lineTo(k * 2 + 2, -s * 0.8);
+      ctx.stroke();
+      ctx.fillStyle = theme.palmLight;
+      ctx.beginPath();
+      ctx.ellipse(k * 2 + 2, -s * 0.6, 2.8, 1.4, k * 0.4, 0, TAU);
+      ctx.fill();
+    }
+  } else {
+    // Grass, dry brush and short rushes on low or arid coasts.
+    ctx.strokeStyle = dry.has(style) ? theme.peaks[2] : theme.palmLight;
+    ctx.lineWidth = 1.3;
+    for (let k = 0; k < 7; k++) {
+      const a = k * TAU / 7;
+      ctx.beginPath();
+      ctx.moveTo(0, 0);
+      ctx.lineTo(Math.cos(a) * s * (0.5 + rnd() * 0.5), Math.sin(a) * s * (0.5 + rnd() * 0.5));
+      ctx.stroke();
+    }
+  }
+  ctx.restore();
+}
+
+function reeds(ctx: CanvasRenderingContext2D, x: number, y: number, rnd: Rng, theme: IslandTheme) {
+  ctx.strokeStyle = theme.palmDark;
+  ctx.lineWidth = 1.2;
+  for (let k = 0; k < 5; k++) {
+    const dx = (rnd() - 0.5) * 14;
+    const dy = (rnd() - 0.5) * 11;
+    ctx.beginPath();
+    ctx.moveTo(x + dx, y + dy + 4);
+    ctx.lineTo(x + dx + 3, y + dy - 5 - rnd() * 6);
+    ctx.stroke();
+    if (k % 2 === 0) {
+      ctx.fillStyle = theme.palmTrunk;
+      ctx.fillRect(x + dx + 2, y + dy - 10, 1.5, 3.5);
+    }
+  }
+}
+
+function marker(ctx: CanvasRenderingContext2D, style: IslandStyle, r: number, theme: IslandTheme, rnd: Rng) {
+  const s = Math.max(9, r * (style === 'lake' || style === 'karst' ? 0.17 : 0.13));
+  ctx.save();
+  ctx.translate(-r * 0.23, -r * 0.2);
+  switch (style) {
+    case 'chalk': // a white station lighthouse on the cliff
+      ctx.fillStyle = '#f7f3dc';
+      ctx.fillRect(-s * 0.35, -s, s * 0.7, s * 1.6);
+      ctx.fillStyle = '#a44436';
+      ctx.fillRect(-s * 0.46, -s * 1.2, s * 0.92, s * 0.3);
+      ctx.fillStyle = '#fce3a0';
+      ctx.fillRect(-s * 0.23, -s * 0.6, s * 0.46, s * 0.22);
+      break;
+    case 'aegean': // bleached columns on a promontory
+    case 'limestone':
+      ctx.fillStyle = '#f0e9d7';
+      for (let i = -1; i <= 1; i++) {
+        ctx.fillRect(i * s * 0.46 - 1.4, -s * 0.32, 2.8, s * 0.75);
+        ctx.fillRect(i * s * 0.46 - 2, -s * 0.39, 4, 2);
+      }
+      break;
+    case 'ionian': // olive terraces and a roofed stone sea watch
+      ctx.strokeStyle = '#d9c99e';
+      ctx.lineWidth = 2;
+      for (let i = -1; i <= 1; i++) {
+        ctx.beginPath();
+        ctx.moveTo(-s, i * s * 0.4);
+        ctx.quadraticCurveTo(0, i * s * 0.4 - s * 0.12, s, i * s * 0.4);
+        ctx.stroke();
+      }
+      ctx.fillStyle = '#d1c2a5';
+      ctx.fillRect(-s * 0.28, -s * 0.4, s * 0.56, s * 0.7);
+      ctx.fillStyle = '#ad653f';
+      ctx.fillRect(-s * 0.38, -s * 0.53, s * 0.76, s * 0.2);
+      break;
+    case 'bosporus': // a small tiled dome and its square base
+      ctx.fillStyle = '#c9b393';
+      ctx.fillRect(-s * 0.56, -s * 0.4, s * 1.12, s * 0.8);
+      ctx.fillStyle = '#486673';
+      ctx.beginPath(); ctx.arc(0, 0, s * 0.36, 0, TAU); ctx.fill();
+      break;
+    case 'desert': // walled courtyard
+      ctx.fillStyle = '#d8bb81';
+      ctx.fillRect(-s * 0.8, -s * 0.55, s * 1.6, s * 1.1);
+      ctx.fillStyle = '#b08a57';
+      ctx.fillRect(-s * 0.43, -s * 0.3, s * 0.86, s * 0.65);
+      break;
+    case 'nordic': // turf-roof longhouse
+      ctx.fillStyle = '#5c6555';
+      ctx.fillRect(-s, -s * 0.4, s * 2, s * 0.8);
+      ctx.strokeStyle = '#baa992';
+      ctx.lineWidth = 2;
+      ctx.strokeRect(-s, -s * 0.4, s * 2, s * 0.8);
+      break;
+    case 'marsh': // tidal channels cut through reed flats
+    case 'delta':
+      ctx.strokeStyle = theme.wetSand;
+      ctx.lineWidth = 4;
+      ctx.beginPath();
+      ctx.moveTo(-s, -s); ctx.quadraticCurveTo(s * 0.7, -s * 0.3, s, s);
+      ctx.stroke();
+      break;
+    case 'karst': // grey limestone towers and the tidal stakes below them
+      for (let i = 0; i < 3; i++) {
+        const x = (i - 1) * s * 0.7;
+        ctx.fillStyle = theme.peaks[i % 2];
+        ctx.beginPath();
+        ctx.moveTo(x - s * 0.34, s * 0.38);
+        ctx.lineTo(x - s * 0.22, -s * (0.9 + rnd() * 0.45));
+        ctx.lineTo(x + s * 0.23, -s * 0.55);
+        ctx.lineTo(x + s * 0.35, s * 0.38);
+        ctx.fill();
+      }
+      break;
+    case 'japan': // a vermilion shore gate
+      ctx.fillStyle = '#a93125';
+      ctx.fillRect(-s * 0.6, -s * 0.62, s * 0.15, s * 1.1);
+      ctx.fillRect(s * 0.45, -s * 0.62, s * 0.15, s * 1.1);
+      ctx.fillRect(-s * 0.85, -s * 0.72, s * 1.7, s * 0.15);
+      ctx.fillRect(-s * 0.72, -s * 0.32, s * 1.44, s * 0.1);
+      break;
+    case 'korea': // stone signal/watch tower
+      ctx.fillStyle = '#a5aa99';
+      ctx.fillRect(-s * 0.48, -s * 0.4, s * 0.96, s * 0.9);
+      ctx.fillStyle = '#343e3a';
+      ctx.fillRect(-s * 0.7, -s * 0.55, s * 1.4, s * 0.25);
+      break;
+    case 'fern': // timber palisade curving around the ridge
+      ctx.strokeStyle = '#785b38';
+      ctx.lineWidth = 2;
+      ctx.beginPath();
+      ctx.arc(0, 0, s * 0.95, 0.25, Math.PI * 1.55);
+      ctx.stroke();
+      for (let k = 0; k < 7; k++) {
+        const a = k * 0.66 + 0.25;
+        ctx.fillStyle = '#8b693e';
+        ctx.fillRect(Math.cos(a) * s * 0.95, Math.sin(a) * s * 0.95, 2, 4);
+      }
+      break;
+    case 'lava': // basalt fissures radiating from a dark volcanic cone
+      ctx.fillStyle = '#282824';
+      ctx.beginPath(); ctx.arc(0, 0, s * 1.35, 0, TAU); ctx.fill();
+      ctx.fillStyle = '#6a5040';
+      ctx.beginPath(); ctx.arc(-s * 0.2, -s * 0.2, s * 0.48, 0, TAU); ctx.fill();
+      for (let k = 0; k < 6; k++) {
+        const a = k * TAU / 6;
+        ctx.strokeStyle = '#29231f';
+        ctx.lineWidth = 1.7;
