+++ b/tests/tutorial-flow.test.tsx
@@ -0,0 +1,123 @@
+/** @vitest-environment jsdom */
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import App from '../src/App';
+import { loadScores } from '../src/game/storage';
+import type { GameStats, Screen, UpgradeOffer } from '../src/game/types';
+import type { TutorialChapterId } from '../src/game/tutorial';
+
+const sink = vi.hoisted(() => ({
+  callbacks: null as null | {
+    onScreen: (s: Screen) => void;
+    onGameOver: (s: GameStats) => void;
+    onUpgrade: (offers: UpgradeOffer[], wave: number) => void;
+  },
+  instance: null as null | { chapter: TutorialChapterId; demonstrating: boolean },
+}));
+
+// Run the app/menu/overlay as-is; only replace canvas rendering with an engine
+// that reports the same lesson and screen transitions.
+vi.mock('../src/game/engine', () => ({
+  Engine: class {
+    input = { touchFireHeld: false, smartQueued: false };
+    chapter: TutorialChapterId = 'helm';
+    demonstrating = false;
+    completed = false;
+    guns = 3;
+    constructor(_canvas: HTMLCanvasElement, private cb: NonNullable<typeof sink.callbacks>) {
+      sink.callbacks = cb;
+      sink.instance = this;
+    }
+    setAudio() {}
+    setEra() {}
+    setRegion() {}
+    destroy() {}
+    getBoardCandidate() { return null; }
+    getGrapeshot() { return null; }
+    getTutorialStatus() {
+      return {
+        chapter: this.chapter, demonstrating: this.demonstrating, completed: this.completed,
+        hull: 100, maxHull: 100, guns: this.guns, sails: 40,
+        crew: 45, gold: 0, prisoners: 0, boarded: 0,
+        portReload: 0, starboardReload: 0,
+      };
+    }
+    startTutorial() { this.setTutorialChapter('helm'); }
+    setTutorialChapter(chapter: TutorialChapterId) {
+      this.chapter = chapter;
+      this.completed = false;
+      this.demonstrating = false;
+      if (chapter === 'upgrades') {
+        this.cb.onUpgrade([{
+          def: { id: 'cannons', name: 'Extra Cannons', desc: '+1 gun on each broadside', max: 4 }, level: 0,
+        }], 1);
+        this.cb.onScreen('upgrade');
+      } else {
+        this.cb.onScreen('playing');
+      }
+    }
+    playTutorialDemo() { this.demonstrating = true; }
+    chooseUpgrade() {
+      this.completed = true;
+      this.guns++;
+      this.cb.onScreen('playing');
+    }
+    pause() { this.cb.onScreen('paused'); }
+    quitToMenu() { this.cb.onScreen('menu'); }
+  },
+}));
+vi.mock('../src/components/EraCarousel', () => ({ EraCarousel: () => <div>Era picker</div> }));
+
+beforeEach(() => window.localStorage.clear());
+afterEach(() => { cleanup(); sink.callbacks = null; sink.instance = null; window.localStorage.clear(); });
+
+it('opens a real-engine tutorial, moves through lessons and returns to the title without a score', async () => {
+  render(<App />);
+  fireEvent.click(screen.getByRole('button', { name: 'Tutorial' }));
+  expect(screen.getByRole('region', { name: "Captain's tutorial" })).toBeTruthy();
+  expect(screen.getByText('Take the helm')).toBeTruthy();
+
+  fireEvent.click(screen.getByRole('button', { name: /watch the captain/i }));
+  expect(screen.getByText(/Watch the ship in action/)).toBeTruthy();
+  fireEvent.click(screen.getByRole('button', { name: /show instructions/i }));
+  for (let lesson = 1; lesson < 8; lesson++) {
+    fireEvent.click(screen.getByRole('button', { name: /next lesson/i }));
+  }
+  expect(screen.getByText(/Pick a real upgrade/)).toBeTruthy();
+  const card = screen.getByRole('button', { name: /Extra Cannons/i });
+  await waitFor(() => expect(card.hasAttribute('disabled')).toBe(false));
+  fireEvent.click(card);
+  expect(screen.getByText('Visit the shipwright')).toBeTruthy();
+  await waitFor(() => expect(screen.getByText(/Well done!/)).toBeTruthy());
+  fireEvent.click(screen.getByRole('button', { name: /next lesson/i }));
+  expect(screen.getByText('Ready for the open sea')).toBeTruthy();
+  fireEvent.click(screen.getByRole('button', { name: /return to port/i }));
+  expect(screen.getByRole('button', { name: 'Tutorial' })).toBeTruthy();
+  expect(loadScores()).toEqual([]);
+});
+
+it('restarts the tutorial from pause instead of launching a scored voyage', () => {
+  render(<App />);
+  fireEvent.click(screen.getByRole('button', { name: 'Tutorial' }));
+  fireEvent.click(screen.getByRole('button', { name: /next lesson/i }));
+  expect(screen.getByText('Read the wind & shore')).toBeTruthy();
+  fireEvent.click(screen.getByRole('button', { name: 'Pause tutorial' }));
+  expect(screen.getByRole('button', { name: /Restart Tutorial/i })).toBeTruthy();
+  fireEvent.click(screen.getByRole('button', { name: /Restart Tutorial/i }));
+  expect(screen.getByText('Take the helm')).toBeTruthy();
+  expect(screen.getByRole('region', { name: "Captain's tutorial" })).toBeTruthy();
+  fireEvent.click(screen.getByRole('button', { name: 'Exit tutorial' }));
+  expect(loadScores()).toEqual([]);
+});
+
+it('refuses to save even an unexpected game-over score in practice', () => {
+  render(<App />);
+  fireEvent.click(screen.getByRole('button', { name: 'Tutorial' }));
+  const stats: GameStats = { score: 900, wave: 1, sunk: 2, gold: 300, accuracy: 1, maxStreak: 2, time: 10 };
+  act(() => {
+    sink.callbacks!.onScreen('gameover');
+    sink.callbacks!.onGameOver(stats);
+  });
+  expect(loadScores()).toEqual([]);
+  expect(screen.getByRole('button', { name: 'Tutorial' })).toBeTruthy();
+});
