@@ -0,0 +1,140 @@
+// Original game cues, not transcriptions of traditional music. Scale colours,
+// phrasing, instrumentation and drum patterns distinguish eras without treating
+// a modern sea shanty as the soundtrack to an ancient or distant fleet.
+import type { EraId, RegionId } from '../types';
+import type { Cassette, Deck, MusicMode } from './cassette';
+
+export type ThemeEra = Exclude<EraId, 'golden'>;
+type Voice = 'pluck' | 'flute' | 'bell' | 'reed' | 'fiddle';
+type Groove = 'tide' | 'oars' | 'frame' | 'march' | 'wood' | 'forge' | 'electronic';
+
+export interface RegionalScore {
+  region: RegionId;
+  /** Two wave songs and a distinct boss cue. */
+  titles: readonly [string, string, string];
+  tonic: number; // MIDI pitch of the home note
+  scale: readonly number[]; // ascending semitones above the home note
+  /** Three 16-beat phrases of scale degrees; a dot is a rest, | separates bars. */
+  phrases: readonly [string, string, string];
+  lead: Voice;
+  reply: Voice;
+  groove: Groove;
+  step: number; // seconds per sixteenth step on wave 1
+}
+
+function parsePhrase(line: string, scaleLength: number): number[] {
+  const notes = line.trim().split(/[\s|]+/).map((token) => token === '.' ? -1 : Number(token));
+  if (notes.length !== 16 || notes.some((n) => !Number.isInteger(n) || n < -1 || n >= scaleLength * 2)) {
+    throw new Error(`Regional cassette needs 16 valid scale degrees: ${line}`);
+  }
+  return notes;
+}
+
+function voice(deck: Deck, kind: Voice, pitch: number, t: number, dur: number, vol: number, pan = 0) {
+  switch (kind) {
+    case 'pluck': deck.pluck(pitch, t, dur, vol, pan); break;
+    case 'flute': deck.flute(pitch, t, dur, vol, pan); break;
+    case 'bell': deck.bell(pitch, t, dur, vol, pan); break;
+    case 'reed': deck.reed(pitch, t, dur, vol, pan, 0, 1350); break;
+    case 'fiddle': deck.fiddle(pitch, t, dur, vol, pan); break;
+  }
+}
+
+function rhythm(deck: Deck, groove: Groove, inBar: number, t: number, mode: MusicMode, boss: boolean) {
+  if (mode === 0 && !boss) {
+    if (groove === 'tide' && inBar === 12) deck.noise(t, 0.1, 0.012, 1200);
+    return;
+  }
+  if (mode === 2) {
+    if (inBar === 0 || inBar === 8) deck.drum('sine', 65, 30, t, 0.22, inBar === 0 ? 0.32 : 0.2);
+    if (inBar === 0) deck.noise(t, 0.09, 0.025, 550);
+    return;
+  }
+  switch (groove) {
+    case 'tide':
+      if (inBar === 0 || inBar === 10) deck.drum('sine', 70, 35, t, 0.15, boss ? 0.32 : 0.18);
+      if (inBar === 6 || inBar === 14) deck.noise(t, 0.06, 0.035, 1800);
+      break;
+    case 'oars':
+      if (inBar === 0 || inBar === 8) deck.drum('triangle', 95, 40, t, 0.18, boss ? 0.44 : 0.32);
+      if (inBar === 4 || inBar === 12) deck.noise(t, 0.04, 0.05, 1450);
+      break;
+    case 'frame':
+      if (inBar === 0 || inBar === 6 || inBar === 11) deck.drum('sine', 125, 58, t, 0.11, inBar === 0 ? 0.35 : 0.2);
+      if (inBar === 3 || inBar === 9 || inBar === 14) deck.noise(t, 0.045, 0.055, 2500);
+      break;
+    case 'march':
+      if (inBar === 0 || inBar === 8) deck.drum('sine', 115, 42, t, 0.14, 0.32);
+      if (inBar === 4 || inBar === 12) deck.snare(t, boss ? 0.14 : 0.09);
+      break;
+    case 'wood':
+      if (inBar === 0 || inBar === 9) deck.drum('triangle', 180, 100, t, 0.09, boss ? 0.28 : 0.18);
+      if (inBar === 5 || inBar === 13) deck.noise(t, 0.035, 0.037, 2200);
+      break;
+    case 'electronic':
+      // Restrained 1980s electronic percussion: a period-inspired original cue.
+      if (inBar % 4 === 0) deck.drum('sine', 90, 34, t, 0.16, boss ? 0.3 : 0.23);
+      if (inBar === 4 || inBar === 12) deck.snare(t, 0.095);
+      if (inBar % 2 === 1) deck.noise(t, 0.024, 0.025, 4300);
+      break;
+    case 'forge':
+      if (inBar === 0 || inBar === 8) deck.drum('sine', 85, 34, t, 0.17, 0.37);
+      if (inBar === 3 || inBar === 7 || inBar === 11 || inBar === 15) deck.noise(t, 0.06, 0.055, 3600);
+      if (inBar === 4 || inBar === 12) deck.snare(t, 0.07);
+      break;
+  }
+  if (boss && inBar === 15) deck.drum('sine', 90, 34, t, 0.14, 0.25);
+}
+
+/** Two contrasting wave cassettes and one siege/boss cassette per era. */
+export function composeRegionalScore(era: ThemeEra, score: RegionalScore): readonly [Cassette, Cassette, Cassette] {
+  const phrases = score.phrases.map((line) => parsePhrase(line, score.scale.length));
+  const pitch = (degree: number) => score.tonic + score.scale[degree % score.scale.length] +
+    12 * Math.floor(degree / score.scale.length);
+  const make = (take: 0 | 1 | 2): Cassette => {
+    const boss = take === 2;
+    return {
+      era,
+      region: score.region,
+      title: score.titles[take],
+      loopSteps: 128,
+      stepDuration(wave) { return Math.max(0.09, score.step - Math.max(0, wave - 1) * 0.002); },
+      playStep(deck, step, t, sd, mode) {
+        const inBar = step % 16;
+        const bar = Math.floor(step / 16);
+        const phrase = phrases[step < 64
+          ? (take === 0 ? 0 : take === 1 ? 2 : 1)
+          : (take === 0 ? 1 : take === 1 ? 0 : 2)];
+        const index = Math.floor((step % 64) / 4);
+        const degree = phrase[index];
+
+        if (step % 4 === 0 && degree >= 0) {
+          // On the second song and the boss cue the last phrase is answered an
+          // octave higher, instead of simply replaying the first melody.
+          const lift = bar >= 6 && take !== 0 && index % 4 === 0 ? 12 : 0;
+          voice(deck, score.lead, pitch(degree) + lift, t, sd * 3.7, boss ? 0.11 : 0.095, -0.18);
+          if (mode === 1 && inBar === 12) {
+            voice(deck, score.reply, pitch(degree) - (score.reply === 'bell' ? 0 : 12), t, sd * 3.2, 0.045, 0.28);
+          }
+        }
+        // A grace note before the next beat keeps the second arrangement from
+        // being the same melody with a different cassette label.
+        if (take === 1 && mode === 1 && step % 4 === 2 && index % 4 === 2 && phrase[index + 1] >= 0) {
+          voice(deck, score.lead, pitch(phrase[index + 1]), t, sd * 1.5, 0.035, 0.12);
+        }
+
+        const root = score.tonic - 24 + (bar % 4 === 2 ? 7 : 0);
+        if (inBar === 0) deck.bass(root, t, sd * 7, boss ? 0.31 : 0.23);
+        if (inBar === 8 && mode !== 0) deck.bass(root + 7, t, sd * 6, 0.17);
+        if (inBar === 4 && mode !== 2) deck.pluck(root + 12, t, sd * 3, 0.027, 0.32);
+        if (inBar === 12 && mode === 1) deck.pluck(root + 19, t, sd * 2, 0.022, -0.32);
+        if (boss && inBar === 0) {
+          deck.note('triangle', root - 12, t, sd * 15, 0.05, 360);
+          if (mode === 2) deck.note('sawtooth', root - 11, t, sd * 15, 0.032, 320);
+        }
+        rhythm(deck, score.groove, inBar, t, mode, boss);
+      },
+    };
+  };
+  return [make(0), make(1), make(2)];
+}
