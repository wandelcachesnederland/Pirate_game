+    expect(e.getTutorialStatus().hull).toBeGreaterThan(68);
+    expect(e.stats.gold).toBe(65);
+    expect(e.getTutorialStatus().completed).toBe(false);
+
+    e.player.x = chest.x;
+    e.player.y = chest.y;
+    e.updatePickups(0.016);
+    expect(e.stats.gold).toBe(185);
+    expect(e.getTutorialStatus().completed).toBe(true);
+  });
+
+  it('collects real loot and fires real grapeshot in the practice scenes', () => {
+    const e = practice();
+    e.setTutorialChapter('loot');
+    expect(e.pickups).toHaveLength(3);
+    expect(e.player.hp).toBeLessThan(e.player.maxHp);
+    e.player.x = 82;
+    e.updatePickups(0.016);
+    expect(e.stats.gold).toBeGreaterThan(0);
+    expect(e.getTutorialStatus().completed).toBe(true);
+    expect(e.player.hp).toBeGreaterThan(e.player.maxHp - 32);
