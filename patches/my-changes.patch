+import { Anchor, BookOpen, Compass, Skull, Swords } from 'lucide-react';
+import seascape from '../assets/attract-seascape.jpg?inline';
+
+interface AttractScreenProps {
+  hiScore: number;
+  onEnter: () => void;
+  onTutorial: () => void;
+}
+
+/** The arcade cabinet's title card. All lettering and the score remain live, accessible UI. */
+export default function AttractScreen({ hiScore, onEnter, onTutorial }: AttractScreenProps) {
+  return (
+    <section className="attract-screen" aria-label="Broadside title screen">
+      <img className="attract-art" src={seascape} alt="" aria-hidden="true" />
+      <div className="attract-vignette" aria-hidden="true" />
+
+      <header className="attract-masthead">
+        <div className="attract-crestline" aria-hidden="true">
+          <span className="attract-rule" /><Anchor /><span className="attract-dot">✦</span>
+          <span className="attract-crest"><Skull /><Swords /></span>
+          <span className="attract-dot">✦</span><Compass /><span className="attract-rule" />
+        </div>
+        <h1 className="attract-title" aria-label="BROADSIDE!">BROADSIDE<span className="attract-bang">!</span></h1>
+        <div className="attract-ornate-rule" aria-hidden="true"><span>◆</span></div>
+        <p className="attract-subtitle">
+          <span aria-hidden="true">✦</span> SAILS, SWORDS &amp; BOOTY <span aria-hidden="true">✦</span>
+        </p>
+      </header>
+
+      <div className="attract-footer">
+        <div className="attract-actions">
+          <button className="attract-start" type="button" onClick={onEnter}>
+            <span className="attract-start-ornament" aria-hidden="true">❧</span>
+            <span>Press Start</span>
+            <span className="attract-start-ornament" aria-hidden="true">❧</span>
+          </button>
+          <button className="attract-tutorial" type="button" onClick={onTutorial}>
+            <BookOpen aria-hidden="true" /> Tutorial
+          </button>
+        </div>
+        <p className="attract-high-score">High Score <span>{hiScore.toLocaleString()}</span></p>
+        <p className="attract-cabinet">☠ &nbsp; WANDERING SKULL GAMES &nbsp; ☠</p>
+        <p className="attract-prompt">INSERT COIN &nbsp;·&nbsp; PRESS ENTER OR SPACE</p>
+      </div>
+    </section>
+  );
+}
