+    score: 120, wave: 2, sunk: 3, gold: 15, accuracy: 0.5,
+    maxStreak: 2, time: 60, prisoners: 7,
+  };
+  render(<GameOverScreen stats={stats} scores={[]} rank={-1} name="Anne" onRestart={() => {}} onMenu={() => {}} isTouch />);
+  expect(screen.getByText('Prisoners taken').parentElement?.textContent).toContain('7');
