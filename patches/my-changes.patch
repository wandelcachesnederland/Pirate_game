+/** @vitest-environment jsdom */
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { StartScreen } from '../src/components/StartScreen';
+import { GameOverScreen } from '../src/components/GameOverScreen';
+import type { ScoreEntry } from '../src/game/storage';
+
+// The era picker paints canvases; these tests are for the menu flow, not its art.
+vi.mock('../src/components/EraCarousel', () => ({ EraCarousel: () => <div>Era picker</div> }));
+
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+
+const score: ScoreEntry = { name: 'Anne', score: 12345, wave: 5, sunk: 12, date: 1 };
+
+function menu(scores: ScoreEntry[] = []) {
+  const onStart = vi.fn();
+  const props = {
+    name: '', onName: vi.fn(), onStart, onTutorial: vi.fn(), scores, settings: { sfx: true, music: true },
+    onSettings: vi.fn(), isTouch: false, era: 'golden' as const, onEra: vi.fn(),
+  };
+  return { ...render(<StartScreen {...props} />), props, onStart };
+}
+
+describe('cabinet title screen', () => {
+  it('is the first screen, with live high-score text and a working Press Start', () => {
+    const { rerender, props, onStart } = menu();
+    expect(screen.getByRole('heading', { name: 'BROADSIDE!' })).toBeTruthy();
+    expect(screen.getByRole('button', { name: /press start/i })).toBeTruthy();
+    expect(screen.getByText(/High Score/i).textContent).toContain('0');
+    expect(screen.queryByLabelText("Captain's Name")).toBeNull();
+
+    rerender(<StartScreen {...props} scores={[score]} />);
+    expect(screen.getByText(/High Score/i).textContent).toContain('12,345');
+    fireEvent.click(screen.getByRole('button', { name: /press start/i }));
+    expect(screen.getByLabelText("Captain's Name")).toBeTruthy();
+    expect(onStart).not.toHaveBeenCalled();
+  });
+
+  it('opens the tutorial directly, without signing on or starting a scored run', () => {
+    const { props, onStart } = menu();
+    const button = screen.getByRole('button', { name: 'Tutorial' });
+    button.focus();
+    expect(fireEvent.keyDown(button, { code: 'Enter', key: 'Enter' })).toBe(true);
+    expect(screen.queryByLabelText("Captain's Name")).toBeNull();
+    fireEvent.click(button);
+    expect(props.onTutorial).toHaveBeenCalledOnce();
+    expect(onStart).not.toHaveBeenCalled();
+  });
+
+  it('lets keyboard players enter the title, choose an era and set sail', () => {
+    vi.useFakeTimers();
+    const { onStart } = menu();
+    fireEvent.keyDown(window, { code: 'Space', key: ' ' });
+    expect(screen.getByLabelText("Captain's Name")).toBeTruthy();
+    fireEvent.keyDown(window, { code: 'Enter', key: 'Enter' });
+    act(() => vi.advanceTimersByTime(180));
+    expect(screen.getByText('Era picker')).toBeTruthy();
+    fireEvent.keyDown(window, { code: 'Enter', key: 'Enter' });
+    expect(onStart).toHaveBeenCalledOnce();
+  });
+});
+
+it('shows captured crew as prisoners on the end-of-run summary', () => {
+  vi.stubGlobal('requestAnimationFrame', () => 1);
+  vi.stubGlobal('cancelAnimationFrame', () => {});
